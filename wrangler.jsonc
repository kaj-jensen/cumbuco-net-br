{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cumbuco-net-br",
  "compatibility_date": "2026-08-10",
  "main": "./worker/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "cumbuco.net.br/*",
      "zone_name": "cumbuco.net.br"
    },
    {
      "pattern": "www.cumbuco.net.br/*",
      "zone_name": "cumbuco.net.br"
    }
  ],
  "vars": {
    "ENQUIRY_MODE": "whatsapp"
  },
  "analytics_engine_datasets": [
    {
      "binding": "CONVERSION_ANALYTICS",
      "dataset": "cumbuco_net_br_conversions"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
