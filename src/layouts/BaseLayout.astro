---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage";
  structuredData?: Record<string, unknown>[];
}
const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = "/images/content/cumbuco/sunny-kitesurfing-1440.jpg",
  imageAlt = "Praia de Cumbuco, Ceará, Brasil",
  pageType = "WebPage",
  structuredData = [],
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
const pageTitle = title.includes("Cumbuco") ? title : `${title} | Cumbuco Aluguéis`;
const absoluteImage = new URL(image, Astro.site).toString();
const webpageId = `${canonicalUrl.toString()}#webpage`;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.shortName,
      alternateName: "Cumbuco Aluguel por Temporada",
      description: site.description,
      publisher: { "@id": `${site.url}/#organization` },
      inLanguage: "pt-BR",
    },
    {
      "@type": ["LocalBusiness", "LodgingBusiness"],
      "@id": `${site.url}/#organization`,
      name: site.shortName,
      alternateName: "Cumbuco Aluguel por Temporada",
      url: `${site.url}/`,
      logo: {
        "@type": "ImageObject",
        url: `${site.url}/images/brand/cumbuco-vacation-rentals-logo.webp`,
        width: 1236,
        height: 230,
      },
      image: absoluteImage,
      telephone: site.phone,
      email: site.email,
      foundingDate: "2003",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Cumbuco",
        addressRegion: "Ceará",
        addressCountry: "BR",
      },
      areaServed: { "@type": "Place", name: "Cumbuco, Ceará, Brasil" },
      knowsAbout: [
        "Cumbuco aluguel por temporada",
        "Apartamentos em Cumbuco",
        "Casas para alugar em Cumbuco",
        "Turismo em Cumbuco",
        "Kitesurf em Cumbuco",
      ],
    },
    {
      "@type": pageType === "WebPage" ? "WebPage" : ["WebPage", pageType],
      "@id": webpageId,
      url: canonicalUrl.toString(),
      name: pageTitle,
      description,
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@type": "Place", name: "Cumbuco, Ceará, Brasil" },
      primaryImageOfPage: { "@type": "ImageObject", url: absoluteImage, caption: imageAlt },
      inLanguage: "pt-BR",
    },
    ...structuredData,
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#064f55" />
    <meta name="application-name" content={site.shortName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={site.shortName} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/images/brand/cumbuco-app-icon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" /></noscript>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:secure_url" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={jsonLd}></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>
