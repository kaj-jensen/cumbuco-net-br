---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage";
  structuredData?: Record<string, unknown>[];
  analyticsProperty?: string;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}
const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = "/images/content/cumbuco/sunny-kitesurfing-1440.jpg",
  imageAlt = "Praia de Cumbuco, Ceará, Brasil",
  pageType = "WebPage",
  structuredData = [],
  analyticsProperty = "",
  preloadImage = "",
  preloadImageSrcset = "",
  preloadImageSizes = "100vw",
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
const pageTitle = title.includes("Cumbuco") ? title : `${title} | Cumbuco Aluguéis`;
const absoluteImage = new URL(image, Astro.site).toString();
const webpageId = `${canonicalUrl.toString()}#webpage`;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.shortName,
      alternateName: "Cumbuco Aluguel por Temporada",
      description: site.description,
      publisher: { "@id": `${site.url}/#organization` },
      inLanguage: "pt-BR",
    },
    {
      "@type": ["LocalBusiness", "LodgingBusiness"],
      "@id": `${site.url}/#organization`,
      name: site.shortName,
      alternateName: "Cumbuco Aluguel por Temporada",
      url: `${site.url}/`,
      logo: {
        "@type": "ImageObject",
        url: `${site.url}/images/brand/cumbuco-vacation-rentals-logo.webp`,
        width: 1236,
        height: 230,
      },
      image: absoluteImage,
      telephone: site.phone,
      email: site.email,
      foundingDate: "2003",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Cumbuco",
        addressRegion: "Ceará",
        addressCountry: "BR",
      },
      areaServed: { "@type": "Place", name: "Cumbuco, Ceará, Brasil" },
      knowsAbout: [
        "Cumbuco aluguel por temporada",
        "Apartamentos em Cumbuco",
        "Casas para alugar em Cumbuco",
        "Turismo em Cumbuco",
        "Kitesurf em Cumbuco",
      ],
    },
    {
      "@type": pageType === "WebPage" ? "WebPage" : ["WebPage", pageType],
      "@id": webpageId,
      url: canonicalUrl.toString(),
      name: pageTitle,
      description,
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@type": "Place", name: "Cumbuco, Ceará, Brasil" },
      primaryImageOfPage: { "@type": "ImageObject", url: absoluteImage, caption: imageAlt },
      inLanguage: "pt-BR",
    },
    ...structuredData,
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#064f55" />
    <meta name="application-name" content={site.shortName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={site.shortName} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/images/brand/cumbuco-app-icon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link
        rel="preload"
        href={preloadImage}
        imagesrcset={preloadImageSrcset || undefined}
        imagesizes={preloadImageSrcset ? preloadImageSizes : undefined}
        as="image"
        type="image/avif"
        fetchpriority="high"
      />
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:secure_url" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={jsonLd}></script>
    <title>{pageTitle}</title>
  </head>
  <body data-analytics-property={analyticsProperty}>
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script is:inline>
      (() => {
        const send = (event, property = "", source = "unspecified") => {
          const body = JSON.stringify({ event, property, source, page: location.pathname });
          if (navigator.sendBeacon) {
            navigator.sendBeacon("/api/events", new Blob([body], { type: "application/json" }));
          } else {
            fetch("/api/events", { method: "POST", headers: { "content-type": "application/json" }, body, keepalive: true }).catch(() => {});
          }
        };
        window.cumbucoTrack = send;
        send("page_view", document.body.dataset.analyticsProperty || "", "page_load");
        try {
          const referrer = document.referrer ? new URL(document.referrer) : null;
          const searchEngines = [
            [/google\./i, "google"],
            [/bing\.com$/i, "bing"],
            [/search\.yahoo\./i, "yahoo"],
            [/duckduckgo\.com$/i, "duckduckgo"],
            [/ecosia\.org$/i, "ecosia"],
          ];
          const source = referrer && referrer.origin !== location.origin
            ? searchEngines.find(([pattern]) => pattern.test(referrer.hostname))?.[1]
            : null;
          if (source) send("organic_entry", document.body.dataset.analyticsProperty || "", source);
        } catch {
          // Referrer parsing must never affect the page experience.
        }
        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target.closest("[data-track]") : null;
          if (!target) return;
          send(
            target.getAttribute("data-track") || "",
            target.getAttribute("data-track-property") || "",
            target.getAttribute("data-track-source") || "unspecified",
          );
        });
      })();
    </script>
  </body>
</html>
