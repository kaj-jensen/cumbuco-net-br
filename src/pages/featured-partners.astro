---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Featured Partners for Cumbuco Businesses";
const description = "Present your Cumbuco restaurant, hotel, kite school, activity, shop, or service to travellers already planning where to stay and what to do.";
const image = "/images/content/cumbuco/cumbuco-palms-sand-1200.jpg";
const whatsapp = "https://wa.me/5585988139402?text=Hello%2C%20I%20would%20like%20to%20discuss%20becoming%20a%20Featured%20Partner%20on%20Cumbuco.net.";
const faqItems = [
  { question: "Who can apply to become a Featured Partner?", answer: "Established businesses serving Cumbuco visitors may enquire, including restaurants, accommodation, kite schools, activities, transport, shops, and practical services. Every business is reviewed before publication." },
  { question: "Does Featured Partner status guarantee a recommendation?", answer: "No. It provides clearly marked enhanced visibility and direct contact opportunities. Editorial travel guidance and factual listing standards remain separate." },
  { question: "Will prices for partnerships be published online?", answer: "No. The presentation, placement, content needs, and commercial arrangement are discussed directly with each business." },
  { question: "Can a normal listing appear without Featured Partner status?", answer: "Yes. The directory can include selected factual listings without enhanced placement. Inclusion is not automatic, exhaustive, or a ranking." },
];
const structuredData = [
  { "@type": "WebPage", "@id": "https://www.cumbuco.net.br/featured-partners/#page", name: title, description, url: "https://www.cumbuco.net.br/featured-partners/", inLanguage: "en" },
  { "@type": "FAQPage", mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
];
---

<BaseLayout title={title} description={description} canonical="/featured-partners/" image={image} structuredData={structuredData}>
  <section class="partner-hero">
    <picture>
      <source type="image/avif" srcset="/images/content/cumbuco/cumbuco-palms-sand-720.avif 720w, /images/content/cumbuco/cumbuco-palms-sand-1200.avif 1200w" sizes="100vw" />
      <source type="image/webp" srcset="/images/content/cumbuco/cumbuco-palms-sand-720.webp 720w, /images/content/cumbuco/cumbuco-palms-sand-1200.webp 1200w" sizes="100vw" />
      <img src={image} srcset="/images/content/cumbuco/cumbuco-palms-sand-720.jpg 720w, /images/content/cumbuco/cumbuco-palms-sand-1200.jpg 1200w" sizes="100vw" width="1200" height="800" alt="Golden sand and palm trees in Cumbuco" fetchpriority="high" />
    </picture>
    <div class="shade"></div>
    <div class="shell hero-copy">
      <p class="eyebrow">Featured Partners</p>
      <h1>Grow your business with Cumbuco Rentals.</h1>
      <p>Meet travellers while they are choosing where to stay, what to do, and which local businesses to contact.</p>
      <a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer">Start a conversation on WhatsApp ↗</a>
    </div>
  </section>

  <section class="section intro-section">
    <div class="shell intro-grid">
      <div><p class="eyebrow">Relevant visibility</p><h2>Be useful at the moment a visitor decides.</h2></div>
      <div class="prose"><p>Cumbuco.net is evolving from a successful vacation-rental website into a complete local planning resource. The audience is not browsing an unrelated advertising feed: they are actively planning accommodation, meals, lessons, activities, and transport in Cumbuco.</p><p>A Featured Partnership creates a stronger, professionally written presentation inside that journey while sending the visitor directly to your own website, WhatsApp, map, or contact channel.</p></div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">What a partnership can include</p><h2>A better presentation, not just a bigger badge.</h2></div><p class="section-intro">The exact scope is agreed directly according to the business and the most relevant guide pages.</p></div>
      <div class="benefit-grid">
        <article><span>01</span><h3>Enhanced placement</h3><p>Priority visibility in the local directory and carefully selected destination-guide contexts.</p></article>
        <article><span>02</span><h3>Professional copy</h3><p>A clear English-language presentation focused on what international and Brazilian visitors need to know.</p></article>
        <article><span>03</span><h3>Direct enquiries</h3><p>Links to your website, WhatsApp, map, or preferred contact channel without placing a booking barrier between you and the visitor.</p></article>
        <article><span>04</span><h3>Visual presentation</h3><p>Support selecting and presenting suitable photographs when you have the right to provide them for publication.</p></article>
        <article><span>05</span><h3>Relevant context</h3><p>Placement beside useful destination information instead of appearing in an unrelated list.</p></article>
        <article><span>06</span><h3>Ongoing accuracy</h3><p>A structured listing that can be updated when your services or contact details change.</p></article>
      </div>
    </div>
  </section>

  <section class="principles">
    <div class="shell principles-grid">
      <div><p class="eyebrow">Clear for visitors</p><h2>Featured visibility and editorial guidance stay distinct.</h2></div>
      <div>
        <p>A Featured Partner receives enhanced visibility and is identified with a clear badge. The badge does not mean the business bought a higher editorial ranking or that factual visitor guidance will be changed.</p>
        <p>Normal directory listings may also appear without partnership status. Every published listing remains subject to verification, relevance, and the quality standards of Cumbuco.net.</p>
      </div>
    </div>
  </section>

  <section class="section process-section">
    <div class="shell process-grid">
      <div><p class="eyebrow">How it begins</p><h2>One direct conversation.</h2></div>
      <ol>
        <li><span>1</span><div><h3>Tell us about the business</h3><p>Share the official website, location, services, contact channels, and what makes the business useful to Cumbuco visitors.</p></div></li>
        <li><span>2</span><div><h3>We review the fit</h3><p>We check relevance, current information, visual material, and the guide pages where the presentation could genuinely help visitors.</p></div></li>
        <li><span>3</span><div><h3>Agree the presentation</h3><p>The scope and commercial arrangement are discussed privately. No partnership pricing is displayed publicly.</p></div></li>
        <li><span>4</span><div><h3>Publish and maintain</h3><p>The listing is clearly marked where appropriate, linked directly to the business, and given a visible verification date.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="contact-section">
    <div class="shell contact-grid">
      <div><p class="eyebrow">Local business enquiry</p><h2>Let us see whether the partnership makes sense.</h2><p>Send the business name, website or social profile, contact person, category, and the service you want visitors to discover.</p></div>
      <div class="actions"><a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp Cumbuco Rentals ↗</a><a class="button button--ghost" href="mailto:info@cumbuco.net?subject=Featured%20Partner%20enquiry">Email partnership enquiry</a><a class="text-link" href="/city/cumbuco/local-businesses/">View the local directory →</a></div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="shell"><p class="eyebrow">Partnership questions</p><h2>Before getting in touch.</h2><div class="faq-grid">{faqItems.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></div>
  </section>
</BaseLayout>

<style>
  .partner-hero { position: relative; min-height: 37rem; display: grid; align-items: end; overflow: hidden; color: white; }
  .partner-hero picture, .partner-hero picture img, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .partner-hero img { object-fit: cover; object-position: center 55%; }
  .shade { background: linear-gradient(90deg, rgb(3 43 45 / 88%), rgb(3 43 45 / 46%) 60%, rgb(3 43 45 / 12%)), linear-gradient(0deg, rgb(3 35 38 / 58%), transparent 56%); }
  .hero-copy { position: relative; padding-block: clamp(3.5rem, 8vw, 6rem); }
  .hero-copy h1 { max-width: 12ch; }
  .hero-copy > p:not(.eyebrow) { max-width: 42rem; margin-top: 1rem; font-size: clamp(1.05rem, 2vw, 1.26rem); }
  .hero-copy .eyebrow { color: #ffd46c; }
  .hero-copy .button { margin-top: 1.5rem; background: var(--sun); color: var(--ink); }
  .intro-grid, .principles-grid, .process-grid, .contact-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 7rem); }
  .intro-grid h2, .principles-grid h2, .process-grid h2, .contact-grid h2 { max-width: 13ch; }
  .section-intro { max-width: 34rem; color: var(--ink-soft); }
  .benefit-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2rem; border-top: 1px solid var(--line); }
  .benefit-grid article { padding: 1.6rem 1.6rem 1.6rem 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .benefit-grid article:nth-child(3n+2), .benefit-grid article:nth-child(3n+3) { padding-left: 1.6rem; }
  .benefit-grid article:nth-child(3n) { border-right: 0; }
  .benefit-grid span { color: var(--coral); font-weight: 900; }
  .benefit-grid h3 { margin-top: 1.6rem; }
  .benefit-grid p { margin-top: .6rem; color: var(--ink-soft); }
  .principles { padding-block: clamp(3rem, 7vw, 5.5rem); background: var(--ocean); color: white; }
  .principles-grid > div:last-child { display: grid; gap: 1rem; color: rgb(255 255 255 / 78%); }
  .process-grid ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .process-grid li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .process-grid li > span { color: var(--coral); font-family: "Fraunces", Georgia, serif; font-size: 1.5rem; }
  .process-grid li p { margin-top: .3rem; color: var(--ink-soft); }
  .contact-section { padding-block: clamp(3rem, 7vw, 6rem); background: var(--seafoam); }
  .contact-grid > div:first-child > p:last-child { margin-top: .8rem; color: var(--ink-soft); }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; align-content: start; }
  .actions .text-link { width: 100%; margin-top: .5rem; color: var(--ocean); font-weight: 800; text-decoration: none; }
  .faq-section { border-top: 1px solid var(--line); }
  .faq-section h2 { max-width: 13ch; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 2rem; border-top: 1px solid var(--line); }
  .faq-grid article { padding: 1.5rem 1.5rem 1.5rem 0; border-bottom: 1px solid var(--line); }
  .faq-grid article:nth-child(odd) { border-right: 1px solid var(--line); }
  .faq-grid article:nth-child(even) { padding-left: 1.5rem; }
  .faq-grid h3 { font-size: 1.2rem; }
  .faq-grid p { margin-top: .6rem; color: var(--ink-soft); }
  @media (max-width: 800px) { .benefit-grid { grid-template-columns: 1fr 1fr; } .benefit-grid article, .benefit-grid article:nth-child(3n+2), .benefit-grid article:nth-child(3n+3) { padding: 1.4rem; border-right: 1px solid var(--line); } .benefit-grid article:nth-child(even) { border-right: 0; } }
  @media (max-width: 720px) { .partner-hero { min-height: 34rem; } .intro-grid, .principles-grid, .process-grid, .contact-grid, .faq-grid { grid-template-columns: 1fr; } .faq-grid article, .faq-grid article:nth-child(even) { padding: 1.25rem 0; border-right: 0; } }
  @media (max-width: 520px) { .benefit-grid { grid-template-columns: 1fr; } .benefit-grid article, .benefit-grid article:nth-child(3n+2), .benefit-grid article:nth-child(3n+3) { padding: 1.3rem 0; border-right: 0; } }
</style>
