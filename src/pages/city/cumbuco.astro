---
import DestinationGuideNav from "../../components/DestinationGuideNav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const image = "/images/content/cumbuco/sunny-kitesurfing-1440.jpg";
const heroImage = "/images/content/cumbuco/sunny-beach-1440.jpg";
const title = "Guia de Cumbuco: Praia, Kitesurf, Lagoas e Onde Ficar";
const description = "Guia local de Cumbuco com informações sobre praia, kitesurf, dunas, lagoas, restaurantes, transporte, clima e imóveis para temporada.";
const faqItems = [
  { question: "Qual é a melhor época para kitesurf em Cumbuco?", answer: "A temporada principal costuma ir de julho a dezembro, muitas vezes com condições úteis em janeiro. Vento, maré e estado do mar devem ser avaliados localmente todos os dias." },
  { question: "Cumbuco é interessante para quem não pratica kitesurf?", answer: "Sim. Praia, dunas, lagoas, passeios de buggy, restaurantes e imóveis com piscina fazem de Cumbuco uma boa base para famílias, casais e grupos." },
  { question: "Qual é a distância entre Fortaleza e Cumbuco?", answer: "Cumbuco fica a cerca de 30 km de Fortaleza e aproximadamente 40 km do aeroporto. O trajeto costuma levar de 45 a 60 minutos, dependendo do trânsito e do endereço." },
  { question: "Preciso de carro em Cumbuco?", answer: "Não necessariamente. Quem fica perto do centro costuma chegar a pé à praia e a restaurantes. Traslado, táxi, carro por aplicativo ou veículo alugado ajudam nos trajetos ao aeroporto, lagoas e imóveis mais afastados." },
];
const structuredData = [
  { "@type": "TouristDestination", "@id": "https://www.cumbuco.net.br/city/cumbuco/#destination", name: "Cumbuco, Ceará, Brasil", url: "https://www.cumbuco.net.br/city/cumbuco/", description, image: new URL(image, Astro.site).toString(), containedInPlace: { "@type": "AdministrativeArea", name: "Caucaia, Ceará, Brasil" }, inLanguage: "pt-BR" },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://www.cumbuco.net.br/" },
    { "@type": "ListItem", position: 2, name: "Guia de Cumbuco", item: "https://www.cumbuco.net.br/city/cumbuco/" },
  ]},
  { "@type": "FAQPage", mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
];
---

<BaseLayout title={title} description={description} canonical="/city/cumbuco/" image={image} imageAlt="Kitesurf na Praia de Cumbuco" structuredData={structuredData}>
  <section class="destination-hero">
    <picture>
      <source type="image/avif" srcset="/images/content/cumbuco/sunny-beach-720.avif 720w, /images/content/cumbuco/sunny-beach-1440.avif 1440w" sizes="100vw" />
      <source type="image/webp" srcset="/images/content/cumbuco/sunny-beach-720.webp 720w, /images/content/cumbuco/sunny-beach-1440.webp 1440w" sizes="100vw" />
      <img src={heroImage} srcset="/images/content/cumbuco/sunny-beach-720.jpg 720w, /images/content/cumbuco/sunny-beach-1440.jpg 1440w" sizes="100vw" width="1440" height="1080" alt="Praia de Cumbuco em um dia claro" fetchpriority="high" />
    </picture>
    <div class="shade"></div>
    <div class="shell hero-copy"><p class="eyebrow">Guia local de Cumbuco</p><h1>Praia, vento e vida de vila.</h1><p>Informação prática para escolher onde ficar e aproveitar Cumbuco no seu próprio ritmo.</p></div>
  </section>

  <DestinationGuideNav current="hub" />

  <section class="guide-section">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Planeje sua estadia</p><h2>Comece pelo que importa para a sua viagem.</h2></div><p>Os guias abaixo reúnem orientação específica, escrita para Cumbuco e organizada para consulta rápida.</p></div>
      <div class="guide-grid">
        <a href="/city/cumbuco/where-to-stay/"><span>Hospedagem</span><h3>Onde ficar</h3><p>Centro, beira-mar, condomínios, casas e vilas.</p><strong>Abrir guia →</strong></a>
        <a href="/city/cumbuco/travel-information/"><span>Planejamento</span><h3>Informações de viagem</h3><p>Aeroporto, transporte, clima, compras e detalhes práticos.</p><strong>Abrir guia →</strong></a>
        <a href="/city/cumbuco/restaurants/"><span>Gastronomia</span><h3>Onde comer</h3><p>Da praia ao centro, com escolhas para diferentes momentos.</p><strong>Abrir guia →</strong></a>
        <a href="/city/cumbuco/things-to-do/"><span>Passeios</span><h3>O que fazer</h3><p>Dunas, lagoas, buggy, praia e dias sem programação.</p><strong>Abrir guia →</strong></a>
        <a href="/city/cumbuco/beaches/"><span>Água</span><h3>Praias e lagoas</h3><p>Condições, acesso e diferenças entre mar e água doce.</p><strong>Abrir guia →</strong></a>
        <a href="/city/cumbuco/kiteboarding/"><span>Vento</span><h3>Kitesurf</h3><p>Temporada, aulas, segurança, equipamento e logística.</p><strong>Abrir guia →</strong></a>
        <a href="/city/cumbuco/local-businesses/"><span>Serviços</span><h3>Guia local</h3><p>Contatos organizados por categoria para falar diretamente.</p><strong>Abrir diretório →</strong></a>
      </div>
    </div>
  </section>

  <section class="section intro-section">
    <div class="shell intro-grid"><div><p class="eyebrow">Cumbuco na prática</p><h2>Perto de Fortaleza, com um ritmo próprio.</h2></div><div class="prose"><p>Cumbuco fica no município de Caucaia, no litoral do Ceará. A proximidade com Fortaleza facilita a chegada, mas a praia extensa, as dunas e a vida concentrada da vila mudam rapidamente a sensação da viagem.</p><p>O destino ganhou projeção internacional pelo kitesurf. Ainda assim, funciona igualmente bem para quem quer caminhar na praia, conhecer as lagoas, reunir a família em uma casa com piscina ou simplesmente aproveitar dias mais tranquilos.</p></div></div>
  </section>

  <section class="facts"><div class="shell fact-grid"><div><strong>30 km</strong><span>aproximadamente de Fortaleza</span></div><div><strong>45–60 min</strong><span>trajeto usual desde o aeroporto</span></div><div><strong>Jul–dez</strong><span>principal temporada de vento</span></div><div><strong>Fev–mai</strong><span>principal período chuvoso</span></div></div></section>

  <section class="section section--sand">
    <div class="shell local-grid"><div><p class="eyebrow">Escolhas que mudam a experiência</p><h2>Localização vem antes da lista de comodidades.</h2></div><div class="local-list"><article><h3>Centro da vila</h3><p>Facilita restaurantes, pequenas compras e saídas a pé, especialmente para quem não pretende alugar carro.</p></article><article><h3>Beira-mar</h3><p>Prioriza o acesso à praia. Confirme se o imóvel realmente tem saída direta para a areia ou apenas vista para o mar.</p></article><article><h3>Casas e condomínios</h3><p>Podem oferecer piscina, jardim, cozinha e mais espaço, mas a distância até o centro varia bastante.</p></article><article><h3>Viagem de kite</h3><p>Considere armazenamento, lavagem do equipamento, acesso ao pico e transporte de boardbags antes de reservar.</p></article></div></div>
  </section>

  <section class="section faq-section"><div class="shell"><p class="eyebrow">Perguntas frequentes</p><h2>Antes de chegar a Cumbuco.</h2><div class="faq-grid">{faqItems.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></div></section>

  <section class="section final-cta"><div class="shell cta-grid"><div><p class="eyebrow">Imóveis em Cumbuco</p><h2>Encontre uma base que funcione para o seu grupo.</h2></div><a class="button" href="/properties/">Ver imóveis disponíveis</a></div></section>
</BaseLayout>

<style>
  .destination-hero { position: relative; min-height: min(44rem, calc(100vh - 5rem)); display: grid; align-items: end; overflow: hidden; color: white; }
  .destination-hero picture, .destination-hero img, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .destination-hero img { object-fit: cover; object-position: center 70%; }
  .shade { background: linear-gradient(90deg, rgb(4 44 46 / 68%), rgb(4 44 46 / 10%) 72%), linear-gradient(0deg, rgb(4 44 46 / 62%), transparent 60%); }
  .hero-copy { position: relative; padding-bottom: clamp(4rem, 9vw, 7rem); }
  .hero-copy h1 { max-width: 10ch; }
  .hero-copy > p:last-child { max-width: 38rem; margin-top: 1rem; font-size: clamp(1.05rem, 2vw, 1.28rem); }
  .hero-copy .eyebrow { color: #ffd46c; }
  .guide-section { padding-block: clamp(3rem, 7vw, 5.5rem); background: var(--seafoam); }
  .section-heading { display: grid; grid-template-columns: 1fr .72fr; gap: 3rem; align-items: end; }
  .section-heading h2 { max-width: 14ch; }
  .section-heading > p { color: var(--ink-soft); }
  .guide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; margin-top: 2.5rem; }
  .guide-grid a { min-height: 14rem; display: flex; flex-direction: column; padding: 1.35rem; border-radius: var(--radius); background: var(--ocean-deep); color: white; text-decoration: none; transition: transform 160ms ease, background 160ms ease; }
  .guide-grid a:hover { background: var(--ocean); transform: translateY(-2px); }
  .guide-grid span { color: #ffd46c; font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .guide-grid h3 { margin-top: 1.6rem; font-size: 1.5rem; }
  .guide-grid p { margin-top: .55rem; color: rgb(255 255 255 / 76%); }
  .guide-grid strong { margin-top: auto; padding-top: 1rem; font-size: .78rem; }
  .intro-grid, .local-grid, .cta-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 7rem); }
  .intro-grid h2, .local-grid h2 { max-width: 13ch; }
  .facts { background: var(--ocean-deep); color: white; }
  .fact-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .fact-grid div { padding: 2rem 1.2rem; border-right: 1px solid rgb(255 255 255 / 18%); }
  .fact-grid div:last-child { border-right: 0; }
  .fact-grid strong, .fact-grid span { display: block; }
  .fact-grid strong { color: #ffd46c; font-size: 1.35rem; }
  .fact-grid span { margin-top: .35rem; color: rgb(255 255 255 / 72%); font-size: .85rem; }
  .local-list { border-top: 1px solid var(--line); }
  .local-list article { display: grid; grid-template-columns: 12rem 1fr; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .local-list p, .faq-grid p { color: var(--ink-soft); }
  .faq-section h2 { max-width: 13ch; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 2rem; border-top: 1px solid var(--line); }
  .faq-grid article { padding: 1.5rem 1.5rem 1.5rem 0; border-bottom: 1px solid var(--line); }
  .faq-grid article:nth-child(odd) { border-right: 1px solid var(--line); }
  .faq-grid article:nth-child(even) { padding-left: 1.5rem; }
  .faq-grid p { margin-top: .6rem; }
  .final-cta { background: var(--ocean); color: white; }
  .cta-grid { align-items: center; }
  .cta-grid .eyebrow { color: #ffd46c; }
  .cta-grid .button { justify-self: end; background: white; color: var(--ocean-deep); }
  @media (max-width: 850px) { .guide-grid { grid-template-columns: 1fr 1fr; } .fact-grid { grid-template-columns: 1fr 1fr; } .fact-grid div:nth-child(2) { border-right: 0; } .fact-grid div { border-bottom: 1px solid rgb(255 255 255 / 18%); } }
  @media (max-width: 700px) { .section-heading, .intro-grid, .local-grid, .cta-grid, .faq-grid { grid-template-columns: 1fr; } .guide-grid { grid-template-columns: 1fr; } .guide-grid a { min-height: 12rem; } .local-list article { grid-template-columns: 1fr; gap: .35rem; } .faq-grid article, .faq-grid article:nth-child(even) { padding: 1.25rem 0; border-right: 0; } .cta-grid .button { justify-self: start; } }
</style>
