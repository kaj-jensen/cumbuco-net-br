---
import DestinationGuideNav from "../../components/DestinationGuideNav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const image = "/images/content/cumbuco/sunny-kitesurfing-1440.jpg";
const heroImage = "/images/content/cumbuco/sunny-beach-1440.jpg";
const title = "Cumbuco Travel Guide: Kitesurfing, Weather & Things to Do";
const description = "Plan a Cumbuco stay with practical advice on wind and rainy seasons, Fortaleza airport transfers, beaches, dunes, lagoons, restaurants, and rentals.";

const faqItems = [
  {
    question: "When is the best time for kitesurfing in Cumbuco?",
    answer: "The most reliable wind season generally runs from July into December, with useful conditions often continuing into January. Wind, tide, and sea conditions still change from day to day, so riders should check locally before launching.",
  },
  {
    question: "Is Cumbuco only for kitesurfers?",
    answer: "No. The beach, warm water, dunes, lagoons, buggy trips, restaurants, relaxed beach bars, pools, and easy village life make Cumbuco equally enjoyable for families, couples, and groups who never step onto a kiteboard.",
  },
  {
    question: "How far is Cumbuco from Fortaleza?",
    answer: "Cumbuco is approximately 30 kilometres from central Fortaleza and about 40 kilometres from Fortaleza International Airport. The airport journey commonly takes around 45 to 60 minutes, but traffic and the exact accommodation location make advance transfer planning worthwhile.",
  },
  {
    question: "Where should I stay in Cumbuco?",
    answer: "Choose according to the experience you want: close to the village for restaurants and evening life, directly on the beach for sea access, or in a quieter house or condominium for more space, gardens, and private or shared pools.",
  },
  {
    question: "When is the rainy season in Cumbuco?",
    answer: "Ceará's principal rainy period runs from February through May, with March and April normally the wettest months. Rainfall varies from year to year and tropical rain often comes in concentrated periods rather than lasting all day.",
  },
  {
    question: "Do I need a car in Cumbuco?",
    answer: "Not necessarily. The village centre, restaurants, and nearby beach are manageable on foot from a central stay. A transfer, taxi, app-based ride, authorised buggy, or rental car is useful for the airport, lagoons, more distant properties, and trips along the coast.",
  },
  {
    question: "Is Cumbuco suitable for beginner kitesurfers?",
    answer: "Yes, provided beginners book instruction with a qualified local school and follow its guidance about wind, tide, equipment, and safe launch areas. Conditions that suit an experienced independent rider are not automatically suitable for a first lesson.",
  },
  {
    question: "How many days should I spend in Cumbuco?",
    answer: "Three or four days allow time for the beach, village, dunes, and a lagoon visit. A week or longer makes more sense for kitesurfers, families, and travellers who want weather flexibility and slower days at their rental.",
  },
];

const structuredData = [
  {
    "@type": "TouristDestination",
    "@id": "https://www.cumbuco.net.br/city/cumbuco/#destination",
    name: "Cumbuco, Ceará, Brasil",
    url: "https://www.cumbuco.net.br/city/cumbuco/",
    description,
    image: new URL(image, Astro.site).toString(),
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: "Caucaia, Ceará, Brasil",
    },
    touristType: ["Kitesurfers", "Beach travellers", "Families", "Couples", "Groups"],
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://www.cumbuco.net.br/city/cumbuco/#breadcrumb",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Cumbuco Rentals", item: "https://www.cumbuco.net.br/" },
      { "@type": "ListItem", position: 2, name: "Cumbuco Travel Guide", item: "https://www.cumbuco.net.br/city/cumbuco/" },
    ],
  },
  {
    "@type": "FAQPage",
    "@id": "https://www.cumbuco.net.br/city/cumbuco/#faq",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical="/city/cumbuco/" image={image} imageAlt="Kitesurfing above the Atlantic coast at Cumbuco" structuredData={structuredData}>
  <section class="destination-hero">
    <picture>
      <source type="image/avif" srcset="/images/content/cumbuco/sunny-beach-720.avif 720w, /images/content/cumbuco/sunny-beach-1440.avif 1440w" sizes="100vw" />
      <source type="image/webp" srcset="/images/content/cumbuco/sunny-beach-720.webp 720w, /images/content/cumbuco/sunny-beach-1440.webp 1440w" sizes="100vw" />
      <img src={heroImage} srcset="/images/content/cumbuco/sunny-beach-720.jpg 720w, /images/content/cumbuco/sunny-beach-1440.jpg 1440w" sizes="100vw" width="1440" height="1080" alt="Bright blue sky, warm sand, and the Atlantic shoreline at Cumbuco beach" fetchpriority="high" />
    </picture>
    <div class="shade"></div>
    <div class="shell hero-copy">
      <p class="eyebrow">Cumbuco destination guide</p>
      <h1>Where the trade winds meet village life.</h1>
      <p>A warm-water beach destination in Ceará, Brazil, known around the world for kitesurfing—and loved locally for much more.</p>
    </div>
  </section>

  <DestinationGuideNav current="hub" />

  <section class="guide-directory-section">
    <div class="shell">
      <div class="directory-heading">
        <div>
          <p class="eyebrow">Build your Cumbuco stay</p>
          <h2>Start with the question that matters now.</h2>
        </div>
        <p>Choose the guide that matches the day you are planning. Every topic now opens into its own practical Cumbuco guide.</p>
      </div>
      <div class="guide-directory">
        <a class="guide-card guide-card--primary" href="/city/cumbuco/where-to-stay/"><span>Stay</span><h3>Where to stay</h3><p>Compare the village, beachfront condominiums, houses, and villas.</p><strong>Open guide →</strong></a>
        <a class="guide-card guide-card--primary" href="/city/cumbuco/travel-information/"><span>Plan</span><h3>Travel information</h3><p>Airport transfers, weather, money, power, packing, and getting around.</p><strong>Open guide →</strong></a>
        <a class="guide-card guide-card--primary" href="/city/cumbuco/restaurants/"><span>Taste</span><h3>Restaurants</h3><p>Beach tables, Ceará flavours, and village evenings.</p><strong>Open guide →</strong></a>
        <a class="guide-card guide-card--primary" href="/city/cumbuco/things-to-do/"><span>Discover</span><h3>Things to do</h3><p>Dunes, lagoons, shoreline walks, and slower days at home.</p><strong>Open guide →</strong></a>
        <a class="guide-card guide-card--primary" href="/city/cumbuco/beaches/"><span>Water</span><h3>Beaches & lagoons</h3><p>Atlantic beach life and freshwater landscapes beyond the village.</p><strong>Open guide →</strong></a>
        <a class="guide-card guide-card--primary" href="/city/cumbuco/kiteboarding/"><span>Ride</span><h3>Kiteboarding</h3><p>Wind seasons, safe planning, lessons, storage, and local conditions.</p><strong>Open guide →</strong></a>
        <a class="guide-card guide-card--primary" href="/city/cumbuco/local-businesses/"><span>Local</span><h3>Local directory</h3><p>Verified direct links for food, stays, kite schools, and useful services.</p><strong>Open directory →</strong></a>
      </div>
    </div>
  </section>

  <nav class="anchor-nav" aria-label="On this Cumbuco guide page">
    <div class="shell">
      <a href="#why-cumbuco">Why visit</a>
      <a href="#when-to-visit">When to go</a>
      <a href="#kitesurfing">Kitesurfing</a>
      <a href="#getting-there">Getting there</a>
      <a href="#food-and-drink">Food & drink</a>
      <a href="#things-to-do">Things to do</a>
      <a href="#plan-your-days">Trip ideas</a>
      <a href="#cumbuco-faq">FAQ</a>
    </div>
  </nav>

  <section class="section" id="why-cumbuco">
    <div class="shell story">
      <div>
        <p class="eyebrow">Why visit Cumbuco</p>
        <h2>A beach village with room to breathe.</h2>
      </div>
      <div class="prose intro-copy">
        <p>Cumbuco sits on the Atlantic coast of Ceará in the municipality of Caucaia, approximately 30 kilometres from Fortaleza. It is close enough for a straightforward arrival, yet the broad beach, coconut palms, dunes, and open horizon quickly create a different rhythm.</p>
        <p>The village grew from a fishing community into one of Brazil’s best-known kitesurfing destinations. Today, international riders share the shoreline with Brazilian holidaymakers, families, long-stay visitors, and people who simply want warm water and an easy life near the sea.</p>
        <p>Cumbuco works because the days can be as active or relaxed as you choose. Ride the wind, visit a lagoon, cross the dunes, settle beside a pool, walk into the village for dinner, or spend an afternoon with your feet in the sand at a beach bar.</p>
      </div>
    </div>
  </section>

  <section class="facts-section" aria-label="Cumbuco quick facts">
    <div class="shell fact-grid">
      <div><strong>30 km</strong><span>approximately from Fortaleza</span></div>
      <div><strong>Jul–Dec</strong><span>core trade-wind season</span></div>
      <div><strong>Feb–May</strong><span>principal rainy period in Ceará</span></div>
      <div><strong>Year-round</strong><span>warm Atlantic days and village life</span></div>
    </div>
  </section>

  <section class="section section--sand" id="kitesurfing">
    <div class="shell feature-grid">
      <div>
        <p class="eyebrow">Kitesurfing in Cumbuco</p>
        <h2>One of the names riders know worldwide.</h2>
      </div>
      <div class="prose">
        <p>Cumbuco’s reputation is built on the steady trade winds that reach Ceará’s coast, warm water, a long open beach, and access to varied conditions. The principal wind season normally builds from July and remains strongest through the second half of the year, often extending into January.</p>
        <p>Experienced riders use Cumbuco as a base for beach sessions and longer downwind journeys along the Ceará coast. Beginners can find instruction locally, but should always learn with a qualified school, understand the launch area, and respect swimmers, other riders, tides, and changing sea conditions.</p>
        <p>The spectacle is part of the destination even when you are not riding. On a good wind day, colourful kites fill the sky from one end of the beach to the other.</p>
        <div class="planning-box">
          <h3>Plan a safer kite trip</h3>
          <ul>
            <li>Reserve lessons and equipment early during the busiest wind months.</li>
            <li>Ask your school which beach or lagoon suits your current ability.</li>
            <li>Check the daily wind, tide, access, and launch conditions locally.</li>
            <li>Arrange secure equipment storage and transport before travelling with a full quiver.</li>
            <li>Use an experienced local guide for any downwinder rather than treating it as an ordinary beach session.</li>
          </ul>
        </div>
        <a class="text-link" href="/properties/">Find a Cumbuco rental near the water →</a>
      </div>
    </div>
  </section>

  <section class="landscape-section" aria-label="Kitesurfing on Cumbuco beach">
    <div class="shell">
      <picture>
        <source type="image/avif" srcset="/images/content/cumbuco/sunny-kitesurfing-720.avif 720w, /images/content/cumbuco/sunny-kitesurfing-1440.avif 1440w" sizes="(max-width: 1200px) 100vw, 1200px" />
        <source type="image/webp" srcset="/images/content/cumbuco/sunny-kitesurfing-720.webp 720w, /images/content/cumbuco/sunny-kitesurfing-1440.webp 1440w" sizes="(max-width: 1200px) 100vw, 1200px" />
        <img src={image} srcset="/images/content/cumbuco/sunny-kitesurfing-720.jpg 720w, /images/content/cumbuco/sunny-kitesurfing-1440.jpg 1440w" sizes="(max-width: 1200px) 100vw, 1200px" width="1440" height="1080" alt="Kitesurfers and colourful kites riding in bright sunshine along Cumbuco beach in Ceará, Brazil" loading="lazy" />
      </picture>
      <p>Trade-wind days bring colourful kites, riders, and long views along Cumbuco’s Atlantic shoreline.</p>
    </div>
  </section>

  <section class="section" id="when-to-visit">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Best time to visit Cumbuco</p>
          <h2>Choose the season for the holiday you want.</h2>
        </div>
        <p class="section-intro">Cumbuco stays warm throughout the year, but wind reliability, rainfall, visitor numbers, and the atmosphere around the village change noticeably.</p>
      </div>
      <div class="season-grid">
        <article><span>July–August</span><h3>The wind returns</h3><p>Rainfall usually eases and the trade-wind season becomes established. These months suit riders who want strong conditions with slightly less peak-season intensity.</p></article>
        <article><span>September–November</span><h3>Prime kite months</h3><p>This is the heart of the international kitesurf season. Expect reliable wind, busy schools, more riders, and stronger demand for beachfront accommodation.</p></article>
        <article><span>December–January</span><h3>Summer and holidays</h3><p>Warm holiday energy continues around the village. Wind can remain useful, but becomes less predictable as the season changes, particularly later in January.</p></article>
        <article><span>February–May</span><h3>Greener and quieter</h3><p>Ceará's principal rainy period brings greener dunes and fewer kite-focused visitors. March and April are normally the wettest months, although conditions vary each year.</p></article>
      </div>
      <p class="source-note">Seasons describe typical patterns, not a daily forecast. Check <a href="https://www.funceme.br/" target="_blank" rel="noopener noreferrer">FUNCEME</a> for regional weather information and a specialist forecast before planning a kite session.</p>
    </div>
  </section>

  <section class="section arrival-section" id="getting-there">
    <div class="shell arrival-grid">
      <div>
        <p class="eyebrow">Getting to Cumbuco</p>
        <h2>From Fortaleza airport to the beach.</h2>
        <p class="lede">Fortaleza International Airport is roughly 40 kilometres from Cumbuco. A normal road journey is often around 45 to 60 minutes, depending on traffic and your exact destination.</p>
      </div>
      <div class="practical-list">
        <article><h3>Pre-arranged transfer</h3><p>The simplest option with luggage, children, or kite equipment. Confirm the flight number, arrival time, passenger count, and equipment dimensions in advance.</p></article>
        <article><h3>Taxi or app-based ride</h3><p>The airport has official taxi services and a designated Uber pick-up area. Confirm that the driver accepts the Cumbuco journey and has enough space before loading.</p></article>
        <article><h3>Rental car</h3><p>Useful when you plan independent lagoon visits or a longer coast itinerary. Confirm parking at the property and avoid driving on dunes or beaches without authorised local access.</p></article>
        <article><h3>Public transport</h3><p>Possible, but normally less convenient because the trip can require city connections. It is rarely the best first choice with suitcases, children, or kite bags.</p></article>
      </div>
    </div>
    <div class="shell arrival-tip">
      <strong>Arrival tip</strong>
      <p>Send us your flight details when enquiring. We can help you compare the practical options for your party and rental location without adding transport automatically to the booking.</p>
      <a href="https://fortaleza-airport.com.br/pt/viajar/guia-do-passageiro" target="_blank" rel="noopener noreferrer">See official Fortaleza Airport transport information →</a>
    </div>
  </section>

  <section class="section dining-section" id="food-and-drink">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Beach bars and restaurants</p>
          <h2>Come off the water hungry. Stay for the view.</h2>
        </div>
        <p class="section-intro">Cumbuco has an informal dining scene that moves between tables in the sand, shaded beachfront restaurants, and the compact village centre.</p>
      </div>
      <div class="duro-feature">
        <figure class="duro-feature__image">
          <picture>
            <source type="image/avif" srcset="/images/content/cumbuco/duro-beach/duro-beach-bar-720.avif 720w, /images/content/cumbuco/duro-beach/duro-beach-bar-1440.avif 1440w" sizes="(max-width: 700px) 100vw, 62vw" />
            <source type="image/webp" srcset="/images/content/cumbuco/duro-beach/duro-beach-bar-720.webp 720w, /images/content/cumbuco/duro-beach/duro-beach-bar-1440.webp 1440w" sizes="(max-width: 700px) 100vw, 62vw" />
            <img src="/images/content/cumbuco/duro-beach/duro-beach-bar-1440.jpg" srcset="/images/content/cumbuco/duro-beach/duro-beach-bar-720.jpg 720w, /images/content/cumbuco/duro-beach/duro-beach-bar-1440.jpg 1440w" sizes="(max-width: 700px) 100vw, 62vw" width="1440" height="1080" loading="lazy" decoding="async" alt="Tables beneath palm trees at Duro Beach with the Atlantic Ocean beyond" />
          </picture>
          <figcaption>Duro Beach brings the classic Cumbuco combination together: palms, sand, sea, music, and an unhurried table.</figcaption>
        </figure>
        <div class="duro-feature__copy">
          <p class="eyebrow">A local example</p>
          <h3>Duro Beach, from lunch into late afternoon.</h3>
          <p>One example of Cumbuco's feet-in-the-sand appeal is Duro Beach. The beach bar and restaurant sits directly by the ocean, so lunch or a cold drink still feels connected to the water, wind, and passing kites.</p>
          <p>It can suit an easy lunch, a post-session drink, or a longer afternoon under the palms. The atmosphere, events, menu, and opening hours can change, so check current details directly before making it part of a fixed plan.</p>
        </div>
      </div>
      <div class="duro-gallery" aria-label="Duro Beach bar and drinks">
        <figure>
          <picture>
            <source type="image/avif" srcset="/images/content/cumbuco/duro-beach/duro-beach-view-720.avif 720w, /images/content/cumbuco/duro-beach/duro-beach-view-1440.avif 1440w" sizes="(max-width: 700px) 100vw, 64vw" />
            <source type="image/webp" srcset="/images/content/cumbuco/duro-beach/duro-beach-view-720.webp 720w, /images/content/cumbuco/duro-beach/duro-beach-view-1440.webp 1440w" sizes="(max-width: 700px) 100vw, 64vw" />
            <img src="/images/content/cumbuco/duro-beach/duro-beach-view-1440.jpg" srcset="/images/content/cumbuco/duro-beach/duro-beach-view-720.jpg 720w, /images/content/cumbuco/duro-beach/duro-beach-view-1440.jpg 1440w" sizes="(max-width: 700px) 100vw, 64vw" width="1440" height="1080" loading="lazy" decoding="async" alt="Open-air dining area at Duro Beach overlooking the sea and kitesurfers" />
          </picture>
          <figcaption>Even from a shaded table, the beach and kites remain part of the scene.</figcaption>
        </figure>
        <figure>
          <picture>
            <source type="image/avif" srcset="/images/content/cumbuco/duro-beach/duro-beach-drinks-720.avif 720w, /images/content/cumbuco/duro-beach/duro-beach-drinks-1440.avif 1440w" sizes="(max-width: 700px) 100vw, 28vw" />
            <source type="image/webp" srcset="/images/content/cumbuco/duro-beach/duro-beach-drinks-720.webp 720w, /images/content/cumbuco/duro-beach/duro-beach-drinks-1440.webp 1440w" sizes="(max-width: 700px) 100vw, 28vw" />
            <img src="/images/content/cumbuco/duro-beach/duro-beach-drinks-1440.jpg" srcset="/images/content/cumbuco/duro-beach/duro-beach-drinks-720.jpg 720w, /images/content/cumbuco/duro-beach/duro-beach-drinks-1440.jpg 1440w" sizes="(max-width: 700px) 100vw, 28vw" width="810" height="1080" loading="lazy" decoding="async" alt="Cold bottled drinks on ice at a Duro Beach table with the ocean behind" />
          </picture>
          <figcaption>Cold drinks, shade, and nowhere you need to hurry to next.</figcaption>
        </figure>
      </div>
      <div class="experience-grid">
        <article><span>01</span><h3>Feet in the sand</h3><p>Beach bars and lounges make it easy to settle in for cold drinks, lunch, and a long view of the Atlantic between swims or kite sessions. Service is generally relaxed, so allow the meal to become part of the afternoon.</p></article>
        <article><span>02</span><h3>Flavours of Ceará</h3><p>Look for fresh fish, prawns, grilled meat, carne de sol, baião de dois, tapioca, tropical fruit, and familiar Brazilian favourites served without unnecessary ceremony.</p></article>
        <article><span>03</span><h3>Village evenings</h3><p>After sunset, the village offers relaxed restaurants, pizza, cafés, cocktails, ice cream, and casual bars within a compact area that is easy to explore on foot.</p></article>
      </div>
      <p class="local-note"><strong>Local planning note:</strong> beachfront kitchens may close earlier than village restaurants, and places or opening hours can change with the season. We are happy to share current suggestions when you enquire about a stay.</p>
    </div>
  </section>

  <section class="section section--sand" id="things-to-do">
    <div class="shell activity-grid">
      <div>
        <p class="eyebrow">Beyond the beach</p>
        <h2>Dunes, lagoons, and unhurried days.</h2>
        <p class="lede">Kitesurfing may be the headline, but it does not have to define the whole holiday.</p>
      </div>
      <div class="activity-list">
        <article><h3>Explore the dunes</h3><p>See the landscape behind the village with an experienced, authorised local buggy operator. Routes and access can vary with conditions.</p></article>
        <article><h3>Visit the lagoons</h3><p>Freshwater lagoons among the dunes offer a different setting from the ocean and are a familiar part of Cumbuco day trips.</p></article>
        <article><h3>Walk the shoreline</h3><p>Beachfront condominiums, restaurants, and the village sit along a coast that rewards an early walk or a cooler late-afternoon wander.</p></article>
        <article><h3>Slow down at home</h3><p>A private villa, garden, veranda, or shared pool can be as important as any excursion—especially for families and larger groups.</p></article>
      </div>
    </div>
  </section>

  <section class="section itinerary-section" id="plan-your-days">
    <div class="shell">
      <p class="eyebrow">A practical Cumbuco itinerary</p>
      <div class="itinerary-heading">
        <h2>Three days is a beginning. A week lets you settle in.</h2>
        <p>Use this as a flexible outline rather than a checklist. Wind, tide, rain, and how slowly you want to travel should shape each day.</p>
      </div>
      <div class="itinerary-grid">
        <article><span>Day 1</span><h3>Beach and village</h3><p>Arrive, learn the immediate area around your rental, walk the beach in daylight, and spend the evening exploring the restaurants around the village centre.</p></article>
        <article><span>Day 2</span><h3>Wind or water</h3><p>Book a kite lesson or supervised session if you ride. Non-riders can choose a relaxed beach day, pool time, or a longer lunch at a beach bar.</p></article>
        <article><span>Day 3</span><h3>Dunes and lagoon</h3><p>Arrange an authorised buggy excursion or local transfer to experience the dune landscape and a freshwater lagoon. Confirm the route and stops before departure.</p></article>
        <article><span>Days 4–7</span><h3>Follow the conditions</h3><p>Leave room for another kite day, a coastal excursion, a quiet morning at home, and the places recommended locally after you arrive.</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="where-to-stay">
    <div class="shell stay-grid">
      <div>
        <p class="eyebrow">Where to stay in Cumbuco</p>
        <h2>Choose the location before the floor plan.</h2>
      </div>
      <div class="prose">
        <p>There is no single best part of Cumbuco. A beachfront apartment can suit travellers who want easy sea access and shared facilities. A villa or independent house offers more privacy and space for a group. Staying closer to the village makes restaurants and evening walks simpler.</p>
        <p>Our property pages explain guest capacity, bedrooms, bathrooms, facilities, and location. Availability is connected to our calendars, and quotations are prepared personally according to dates, number of guests, season, and length of stay.</p>
        <div class="stay-actions">
          <a class="button" href="/properties/">Explore all Cumbuco rentals</a>
          <a class="button button--ghost" href="/contact-cumbuco-rentals/">Ask for local advice</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq-section" id="cumbuco-faq">
    <div class="shell">
      <p class="eyebrow">Planning your trip</p>
      <h2>Cumbuco travel questions.</h2>
      <div class="faq-grid">
        {faqItems.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}
      </div>
      <p class="source-note">For broader regional information, consult <a href="https://visitbrasil.com/en/blog/kitesurfing-in-brazil-water-adventures-and-tourist-destinations/" target="_blank" rel="noopener noreferrer">Visit Brasil’s guide to kitesurfing in Brazil</a>.</p>
    </div>
  </section>

  <section class="section section--ocean final-cta">
