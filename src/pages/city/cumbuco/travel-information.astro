---
import DestinationGuideNav from "../../../components/DestinationGuideNav.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "Viagem a Cumbuco: Aeroporto, Clima, Dinheiro e Bagagem";
const description = "Planeje sua viagem a Cumbuco com informações sobre traslado do aeroporto de Fortaleza, clima, real brasileiro, energia 220V, bagagem e transporte.";
const image = "/images/content/cumbuco/local-travel-1440.jpg";

const faqItems = [
  {
    question: "Qual aeroporto devo usar para viajar a Cumbuco?",
    answer: "O Aeroporto Internacional de Fortaleza (FOR) é o aeroporto de chegada habitual. Cumbuco fica a cerca de 40 quilômetros do terminal, e o trajeto normalmente leva de 45 a 60 minutos, conforme o trânsito e a localização do imóvel.",
  },
  {
    question: "Preciso levar dinheiro em espécie para Cumbuco?",
    answer: "Cartões e Pix são amplamente usados. Ainda assim, uma pequena quantia em reais é útil para compras menores, transporte, gorjetas ou momentos em que a maquininha estiver indisponível.",
  },
  {
    question: "Qual é a voltagem usada em Cumbuco?",
    answer: "A voltagem oficial em Fortaleza e arredores é 220V. As tomadas brasileiras usam dois ou três pinos redondos, no padrão tipo N. Confira cada aparelho e leve o adaptador correto; um adaptador de plugue não converte a voltagem.",
  },
  {
    question: "O que devo levar na mala para Cumbuco?",
    answer: "Leve roupas leves, boa proteção solar, roupa de banho, sandálias confortáveis, um calçado fechado, garrafa reutilizável, medicamentos pessoais e uma capa leve para chuva. Kitesurfistas devem confirmar as regras da companhia aérea e do traslado para o equipamento.",
  },
  {
    question: "Posso circular por Cumbuco sem alugar um carro?",
    answer: "Sim, principalmente a partir de um imóvel central. Restaurantes, o centro e a praia próxima muitas vezes ficam a uma caminhada. Traslados, táxis, carros por aplicativo e operadores autorizados ajudam nos trajetos ao aeroporto, lagoas, dunas e imóveis mais afastados.",
  },
];

const structuredData = [
  {
    "@type": "Article",
    "@id": "https://www.cumbuco.net.br/city/cumbuco/travel-information/#article",
    headline: title,
    description,
    image: new URL(image, Astro.site).toString(),
    about: { "@type": "Place", name: "Cumbuco, Ceará, Brasil" },
    publisher: { "@id": "https://www.cumbuco.net.br/#organization" },
    dateModified: "2026-07-25",
    inLanguage: "pt-BR",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: "https://www.cumbuco.net.br/" },
      { "@type": "ListItem", position: 2, name: "Guia de Cumbuco", item: "https://www.cumbuco.net.br/city/cumbuco/" },
      { "@type": "ListItem", position: 3, name: "Planeje sua viagem", item: "https://www.cumbuco.net.br/city/cumbuco/travel-information/" },
    ],
  },
  {
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical="/city/cumbuco/travel-information/" image={image} structuredData={structuredData}>
  <section class="sub-hero">
    <picture>
      <source type="image/avif" srcset="/images/content/cumbuco/local-travel-720.avif 720w, /images/content/cumbuco/local-travel-1440.avif 1440w" sizes="100vw" />
      <source type="image/webp" srcset="/images/content/cumbuco/local-travel-720.webp 720w, /images/content/cumbuco/local-travel-1440.webp 1440w" sizes="100vw" />
      <img src={image} srcset="/images/content/cumbuco/local-travel-720.jpg 720w, /images/content/cumbuco/local-travel-1440.jpg 1440w" sizes="100vw" width="1440" height="1080" alt="Praia de Cumbuco com coqueiros, equipamentos de kite e mar aberto" fetchpriority="high" />
    </picture>
    <div class="shade"></div>
    <div class="shell hero-copy">
      <p class="eyebrow">Guia prático de viagem a Cumbuco</p>
      <h1>Chegue preparado. Relaxe mais cedo.</h1>
      <p>Do aeroporto de Fortaleza aos dias de praia: reais, tomadas 220V e o que levar na bagagem.</p>
      <small>Informações revisadas em julho de 2026</small>
    </div>
  </section>

  <DestinationGuideNav current="travel-information" />

  <section class="quick-facts" aria-label="Informações essenciais para viajar a Cumbuco">
    <div class="shell fact-grid">
      <div><strong>FOR</strong><span>Aeroporto Internacional de Fortaleza</span></div>
      <div><strong>40 km</strong><span>aproximadamente do aeroporto a Cumbuco</span></div>
      <div><strong>220V</strong><span>dois ou três pinos redondos</span></div>
      <div><strong>45–60 min</strong><span>tempo habitual do traslado</span></div>
    </div>
  </section>

  <section class="section">
    <div class="shell intro-grid">
      <div>
        <p class="eyebrow">Antes de viajar</p>
        <h2>Confirme o essencial antes que a praia tome conta.</h2>
      </div>
      <div class="prose">
        <p>Confirme as regras de bagagem com sua companhia aérea e organize o traslado conforme o horário do voo, o número de passageiros e o volume de malas. Em Cumbuco, esses detalhes fazem mais diferença do que um roteiro genérico.</p>
        <div class="official-links">
          <a href="https://fortaleza-airport.com.br/pt/viajar/guia-do-passageiro" target="_blank" rel="noopener noreferrer"><strong>Aeroporto de Fortaleza</strong><span>Informações atuais sobre passageiros, bagagem, mobilidade e transporte terrestre ↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="getting-here">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Do aeroporto de Fortaleza a Cumbuco</p>
          <h2>As férias começam com um traslado bem planejado.</h2>
        </div>
        <p class="section-intro">O Aeroporto Internacional de Fortaleza fica a cerca de 40 quilômetros de Cumbuco. Trânsito, horário de chegada, bagagem e localização exata do imóvel influenciam o trajeto.</p>
      </div>
      <div class="transport-grid">
        <article>
          <span>01</span>
          <h3>Traslado reservado</h3>
          <p>A chegada mais fácil com crianças, várias malas ou equipamento de kite. Informe antecipadamente voo, horário de pouso, passageiros e dimensões das bolsas.</p>
          <strong>Ideal para: uma primeira chegada tranquila</strong>
        </article>
        <article>
          <span>02</span>
          <h3>Táxi oficial ou carro por aplicativo</h3>
          <p>O aeroporto oferece táxis 24 horas e uma área de embarque da Uber. Confirme o destino em Cumbuco e o espaço para bagagem antes de embarcar.</p>
          <strong>Ideal para: viagens leves e flexíveis</strong>
        </article>
        <article>
          <span>03</span>
          <h3>Carro alugado</h3>
          <p>Útil para um roteiro mais longo pelo Ceará ou para explorar o litoral com independência. Confirme o estacionamento e nunca trate praias ou dunas como vias comuns.</p>
          <strong>Ideal para: independência regional</strong>
        </article>
      </div>
      <div class="arrival-note">
        <strong>Envie os dados do voo.</strong>
        <p>Ao consultar um imóvel, podemos explicar as opções práticas de chegada para aquela localização. O transporte nunca é incluído automaticamente.</p>
        <a href="/contact-cumbuco-rentals/">Perguntar sobre a chegada →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell practical-layout">
      <div class="practical-heading">
        <p class="eyebrow">Dinheiro, energia e conexão</p>
        <h2>Pequenos detalhes que facilitam a estadia.</h2>
      </div>
      <div class="detail-list">
        <article><span>01</span><h3>Pagamentos em Cumbuco</h3><p>Restaurantes, mercados e muitos serviços aceitam Pix e cartão. Leve algum dinheiro para vendedores na praia, pequenas compras ou momentos em que o sinal da maquininha falhar.</p></article>
        <article><span>02</span><h3>Energia 220V</h3><p>A região de Fortaleza usa 220V. As tomadas normalmente aceitam dois ou três pinos redondos. Confira a voltagem do aparelho e leve o adaptador correto.</p></article>
        <article><span>03</span><h3>Internet móvel</h3><p>Wi-Fi e cobertura móvel variam. Quem precisa fazer chamadas de trabalho deve confirmar a conexão do imóvel e preparar uma alternativa de dados.</p></article>
        <article><span>04</span><h3>Compras do dia a dia</h3><p>O centro de Cumbuco reúne pequenos mercados, farmácias e serviços básicos. Para compras grandes ou itens específicos, planeje uma parada em Caucaia ou Fortaleza.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--ocean packing-section" id="packing">
    <div class="shell packing-layout">
      <div>
        <p class="eyebrow">O que levar</p>
        <h2>Prepare-se para sol, vento, água e noites tranquilas.</h2>
        <p>Mantenha a bagagem leve para facilitar os traslados, sem abrir mão da proteção necessária.</p>
      </div>
      <div class="packing-grid">
        <article><span>Vestir</span><p>Roupas leves, trajes de banho, sandálias confortáveis, calçado fechado e uma peça leve para noites com brisa.</p></article>
        <article><span>Proteger</span><p>Protetor solar de alto fator, chapéu, óculos escuros, repelente e capa leve para chuvas tropicais.</p></article>
        <article><span>Levar</span><p>Garrafa reutilizável, bolsa impermeável, cópias de documentos, carregadores, adaptador e medicamentos pessoais.</p></article>
        <article><span>Velejar</span><p>Confirme limites da companhia aérea, capacidade do traslado, armazenamento e seguro antes de viajar com equipamento de kite.</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="weather">
    <div class="shell season-layout">
      <div>
        <p class="eyebrow">Clima e estações</p>
        <h2>Calor o ano inteiro, com ritmos bem diferentes.</h2>
        <p class="lede">A estação indica o padrão habitual, não o tempo de um dia específico.</p>
      </div>
      <div class="season-grid">
        <article><strong>Julho–dezembro</strong><h3>Temporada de ventos alísios</h3><p>Principal período de condições fortes e confiáveis para kitesurf, com maior procura nos meses internacionais de vento.</p></article>
        <article><strong>Dezembro–janeiro</strong><h3>Verão brasileiro</h3><p>Clima de férias, dias quentes na praia e mudança gradual na regularidade do vento.</p></article>
        <article><strong>Fevereiro–maio</strong><h3>Principal período chuvoso</h3><p>Os meses mais úmidos deixam a paisagem verde e recebem menos viagens focadas em kite. A chuva tropical pode ser intensa e concentrada, sem durar o dia inteiro.</p></article>
      </div>
      <p class="source-note">Para previsões atuais e informações climáticas do Ceará, consulte a <a href="https://www.funceme.br/" target="_blank" rel="noopener noreferrer">FUNCEME</a>.</p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell local-grid">
      <div>
        <p class="eyebrow">Depois de chegar</p>
        <h2>Circule por Cumbuco conforme o plano do dia.</h2>
      </div>
      <div class="local-options">
        <article><h3>A pé</h3><p>Uma hospedagem central pode deixar o centro, restaurantes e a praia a uma caminhada confortável. Confira o percurso real antes de reservar.</p></article>
        <article><h3>Táxi ou aplicativo</h3><p>Útil à noite, para compras, trajetos ao aeroporto ou imóveis além de uma distância confortável a pé.</p></article>
        <article><h3>Operador local autorizado</h3><p>Use operadores experientes e autorizados para dunas, lagoas, passeios de buggy e atividades que dependem do acesso e das condições locais.</p></article>
        <article><h3>Carro alugado</h3><p>Ajuda em viagens mais amplas pelo Ceará, mas não é essencial para todas as férias em Cumbuco. Estacionamento e confiança nas estradas devem entrar na decisão.</p></article>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="shell">
      <p class="eyebrow">Perguntas de planejamento</p>
      <h2>Respostas práticas antes da partida.</h2>
      <div class="faq-grid">
        {faqItems.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="shell cta-grid">
      <div><p class="eyebrow">Pronto para escolher sua base?</p><h2>Combine a viagem com a hospedagem certa em Cumbuco.</h2></div>
      <div class="cta-actions">
        <a class="button" href="/properties/">Ver imóveis</a>
        <a class="button button--ghost" href="/city/cumbuco/where-to-stay/">Comparar onde ficar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sub-hero { position: relative; min-height: 36rem; display: grid; align-items: end; overflow: hidden; color: white; }
  .sub-hero picture, .sub-hero picture img, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sub-hero picture { display: block; }
  .sub-hero img { object-fit: cover; object-position: center 58%; }
  .shade { background: linear-gradient(90deg, rgb(3 44 47 / 84%) 0%, rgb(3 44 47 / 46%) 52%, rgb(3 44 47 / 8%) 100%), linear-gradient(0deg, rgb(3 38 41 / 54%), transparent 58%); }
  .hero-copy { position: relative; padding-block: clamp(3.5rem, 8vw, 6rem); }
  .hero-copy h1 { max-width: 10ch; }
  .hero-copy > p:not(.eyebrow) { max-width: 39rem; margin-top: 1.1rem; font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .hero-copy small { display: block; margin-top: 1.1rem; color: rgb(255 255 255 / 72%); }
  .hero-copy .eyebrow { color: #ffd46c; }

  .quick-facts { border-bottom: 1px solid var(--line); background: var(--paper); }
  .fact-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .fact-grid div { display: grid; gap: 0.2rem; padding: 1.6rem; border-right: 1px solid var(--line); }
  .fact-grid div:last-child { border-right: 0; }
  .fact-grid strong { color: var(--ocean); font-family: "Fraunces", Georgia, serif; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1; }
  .fact-grid span { color: var(--ink-soft); font-size: 0.78rem; }

  .intro-grid, .season-layout, .local-grid, .cta-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(3rem, 8vw, 7rem); align-items: start; }
  .intro-grid h2, .local-grid h2 { max-width: 14ch; }
  .official-links { display: grid; gap: 0.75rem; margin-top: 1.5rem; }
  .official-links a { display: grid; gap: 0.2rem; padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: var(--radius); color: var(--ink); text-decoration: none; }
  .official-links a:hover { border-color: var(--ocean); background: var(--seafoam); }
  .official-links span { color: var(--ink-soft); font-size: 0.85rem; }

  .section-intro { max-width: 35rem; color: var(--ink-soft); }
  .transport-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2.5rem; border-block: 1px solid var(--line); }
  .transport-grid article { padding: 1.75rem; border-right: 1px solid var(--line); }
  .transport-grid article:last-child { border-right: 0; }
  .transport-grid span { color: var(--coral); font-size: 0.74rem; font-weight: 800; }
  .transport-grid h3 { margin-top: 2.2rem; }
  .transport-grid p { margin-top: 0.75rem; color: var(--ink-soft); }
  .transport-grid strong { display: block; margin-top: 1.1rem; color: var(--ocean); font-size: 0.8rem; }
  .arrival-note { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1.25rem; align-items: center; margin-top: 2rem; padding: 1.25rem 1.5rem; border-radius: var(--radius); background: var(--seafoam); }
  .arrival-note p { color: var(--ink-soft); }
  .arrival-note a { color: var(--ocean); font-size: 0.86rem; font-weight: 800; }

  .practical-layout { display: grid; gap: clamp(2.5rem, 6vw, 4.5rem); }
  .practical-heading { display: grid; grid-template-columns: minmax(0, .55fr) minmax(0, 1.45fr); gap: clamp(2rem, 7vw, 6rem); align-items: end; }
  .practical-layout h2 { max-width: 18ch; }
  .detail-list { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--line); }
  .detail-list article { padding: 1.6rem; border-right: 1px solid var(--line); }
  .detail-list article:first-child { padding-left: 0; }
  .detail-list article:last-child { padding-right: 0; border-right: 0; }
  .detail-list span { color: var(--coral); font-size: .75rem; font-weight: 800; }
  .detail-list h3 { font-size: 1.2rem; }
  .detail-list span + h3 { margin-top: 1.8rem; }
  .detail-list p { margin-top: 0.65rem; color: var(--ink-soft); font-size: 0.9rem; }

  .packing-section { color: white; }
  .packing-layout { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(3rem, 8vw, 7rem); }
  .packing-layout .eyebrow { color: #ffd46c; }
  .packing-layout h2 { max-width: 12ch; }
  .packing-layout > div:first-child > p:last-child { margin-top: 1rem; color: rgb(255 255 255 / 74%); }
  .packing-grid { display: grid; grid-template-columns: 1fr 1fr; border-block: 1px solid rgb(255 255 255 / 22%); }
  .packing-grid article { padding: 1.5rem; border-right: 1px solid rgb(255 255 255 / 22%); border-bottom: 1px solid rgb(255 255 255 / 22%); }
  .packing-grid article:nth-child(even) { border-right: 0; }
  .packing-grid article:nth-child(n + 3) { border-bottom: 0; }
  .packing-grid span { color: var(--coral-light); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .packing-grid p { margin-top: 0.8rem; color: rgb(255 255 255 / 78%); }

  .season-layout > div:first-child { position: sticky; top: 5rem; }
  .season-layout h2 { max-width: 13ch; }
  .season-grid { display: grid; }
  .season-grid article { padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .season-grid strong { color: var(--coral); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .season-grid h3 { margin-top: 0.4rem; }
  .season-grid p { margin-top: 0.6rem; color: var(--ink-soft); }
  .source-note { margin-top: 1rem; color: var(--ink-soft); font-size: 0.86rem; }
  .source-note a { color: var(--ocean); }

  .local-options { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .local-options article { padding: 1.35rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }
  .local-options h3 { font-size: 1.2rem; }
  .local-options p { margin-top: 0.65rem; color: var(--ink-soft); }

  .faq-section { border-top: 1px solid var(--line); }
  .faq-section h2 { max-width: 14ch; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .faq-grid article { padding: 1.75rem 1.75rem 1.75rem 0; border-bottom: 1px solid var(--line); }
  .faq-grid article:nth-child(odd) { border-right: 1px solid var(--line); }
  .faq-grid article:nth-child(even) { padding-left: 1.75rem; }
  .faq-grid h3 { font-size: 1.25rem; }
  .faq-grid p { margin-top: 0.7rem; color: var(--ink-soft); }
  .cta-grid { align-items: end; }
  .cta-grid h2 { max-width: 14ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; }

  @media (max-width: 850px) {
    .fact-grid, .transport-grid { grid-template-columns: 1fr 1fr; }
    .fact-grid div:nth-child(2), .transport-grid article:nth-child(2) { border-right: 0; }
    .fact-grid div:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .transport-grid article:last-child { grid-column: 1 / -1; border-top: 1px solid var(--line); }
    .arrival-note { grid-template-columns: 1fr; }
    .detail-list { grid-template-columns: 1fr 1fr; }
    .detail-list article:nth-child(2) { border-right: 0; }
    .detail-list article:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }

  @media (max-width: 720px) {
    .sub-hero { min-height: 32rem; }
    .intro-grid, .packing-layout, .season-layout, .local-grid, .faq-grid, .cta-grid, .practical-heading { grid-template-columns: 1fr; }
    .season-layout > div:first-child { position: static; }
    .faq-grid article, .faq-grid article:nth-child(even) { padding: 1.35rem 0; border-right: 0; }
    .cta-actions { justify-content: flex-start; }
  }

  @media (max-width: 520px) {
    .fact-grid, .transport-grid, .detail-list, .packing-grid, .local-options { grid-template-columns: 1fr; }
    .detail-list article, .detail-list article:first-child, .detail-list article:last-child { padding: 1.25rem 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .detail-list article:last-child { border-bottom: 0; }
    .fact-grid div, .transport-grid article { border-right: 0; border-bottom: 1px solid var(--line); }
    .transport-grid article:last-child { grid-column: auto; border-top: 0; }
    .packing-grid article { border-right: 0; border-bottom: 1px solid rgb(255 255 255 / 22%); }
    .packing-grid article:nth-child(n + 3) { border-bottom: 1px solid rgb(255 255 255 / 22%); }
    .packing-grid article:last-child { border-bottom: 0; }
  }
</style>
