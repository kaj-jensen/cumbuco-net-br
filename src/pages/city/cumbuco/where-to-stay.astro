---
import { getCollection } from "astro:content";
import BusinessHighlights from "../../../components/BusinessHighlights.astro";
import DestinationGuideNav from "../../../components/DestinationGuideNav.astro";
import PropertyCard from "../../../components/PropertyCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "Onde Ficar em Cumbuco: Casas, Vilas e Aluguéis à Beira-Mar";
const description = "Compare o centro de Cumbuco, condomínios à beira-mar, casas e vilas. Escolha a localização e o imóvel ideais para suas férias na praia.";
const image = "/images/content/cumbuco/local-accommodation-1440.jpg";

const properties = await getCollection("properties");
const exampleSlugs = ["villa-branca", "dream-village-301-v"];
const examples = exampleSlugs
  .map((slug) => properties.find((property) => property.data.slug === slug))
  .filter(Boolean);

const faqItems = [
  {
    question: "Qual é a melhor região de Cumbuco para ficar sem carro?",
    answer: "Um imóvel próximo ao centro e à praia facilita o acesso a restaurantes, pequenos comércios e passeios à noite. Confirme a localização exata e o percurso a pé antes de reservar, pois as distâncias podem variar mesmo quando o imóvel é anunciado como central.",
  },
  {
    question: "Devo escolher um apartamento à beira-mar ou uma vila privativa?",
    answer: "Apartamentos à beira-mar são indicados para quem valoriza acesso direto à praia, piscinas compartilhadas e praticidade. Vilas atendem melhor grupos maiores que procuram mais quartos, áreas de convivência, jardins e, muitas vezes, piscina privativa.",
  },
  {
    question: "Onde os kitesurfistas devem ficar em Cumbuco?",
    answer: "Priorize armazenamento seguro, acesso prático à praia, espaço para lavar e secar o equipamento e transporte para outros pontos. A praia mais próxima nem sempre é o local de saída adequado para todos os níveis e condições.",
  },
  {
    question: "Os imóveis de Cumbuco são adequados para famílias?",
    answer: "Sim. Muitos apartamentos, casas e vilas funcionam bem para famílias, mas é importante verificar em cada imóvel as piscinas, escadas, varandas, camas, distâncias a pé e necessidades de transporte.",
  },
];

const structuredData = [
  {
    "@type": "Article",
    "@id": "https://www.cumbuco.net.br/city/cumbuco/where-to-stay/#article",
    headline: title,
    description,
    image: new URL(image, Astro.site).toString(),
    about: { "@type": "Place", name: "Cumbuco, Ceará, Brasil" },
    publisher: { "@id": "https://www.cumbuco.net.br/#organization" },
    inLanguage: "pt-BR",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: "https://www.cumbuco.net.br/" },
      { "@type": "ListItem", position: 2, name: "Guia de Cumbuco", item: "https://www.cumbuco.net.br/city/cumbuco/" },
      { "@type": "ListItem", position: 3, name: "Onde ficar", item: "https://www.cumbuco.net.br/city/cumbuco/where-to-stay/" },
    ],
  },
  {
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical="/city/cumbuco/where-to-stay/" image={image} structuredData={structuredData}>
  <section class="sub-hero">
    <picture>
      <source type="image/avif" srcset="/images/content/cumbuco/local-accommodation-720.avif 720w, /images/content/cumbuco/local-accommodation-1440.avif 1440w" sizes="100vw" />
      <source type="image/webp" srcset="/images/content/cumbuco/local-accommodation-720.webp 720w, /images/content/cumbuco/local-accommodation-1440.webp 1440w" sizes="100vw" />
      <img src={image} srcset="/images/content/cumbuco/local-accommodation-720.jpg 720w, /images/content/cumbuco/local-accommodation-1440.jpg 1440w" sizes="100vw" width="1440" height="574" alt="Condomínio à beira-mar com jardins e piscina em Cumbuco" fetchpriority="high" />
    </picture>
    <div class="shade"></div>
    <div class="shell hero-copy">
      <p class="eyebrow">Onde ficar em Cumbuco</p>
      <h1>Escolha primeiro o ritmo das suas férias.</h1>
      <p>O melhor aluguel em Cumbuco é aquele que deixa seu grupo perto do que realmente deseja: praia, centro, kitesurf, privacidade ou tudo isso junto.</p>
    </div>
  </section>

  <DestinationGuideNav current="where-to-stay" />

  <section class="section intro-section">
    <div class="shell intro-grid">
      <div>
        <p class="eyebrow">Comece pela localização</p>
        <h2>Não existe uma única região “melhor” em Cumbuco.</h2>
      </div>
      <div class="prose">
        <p>Cumbuco é compacto, mas a experiência muda entre uma casa perto do centro, um condomínio à beira-mar e uma residência privativa mais tranquila. Alguns minutos a mais a pé ou de carro fazem diferença para quem viaja com crianças, equipamento de kite ou um grupo grande.</p>
        <p>Defina o que precisa ser fácil. Se quiser ir jantar a pé, procure o centro. Se deseja o mar logo depois do portão, confirme o acesso à praia. Se privacidade, quartos e convivência forem prioridade, compare casas e vilas.</p>
        <p><a class="context-link" href="/casas-de-praia-cumbuco/">Compare casas de praia e imóveis com piscina em Cumbuco →</a></p>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Quatro maneiras de se hospedar</p>
          <h2>Escolha o ambiente que combina com suas férias.</h2>
        </div>
        <p class="section-intro">Estas são categorias práticas, não divisões rígidas de bairros. Sempre confira a localização e o acesso de cada imóvel.</p>
      </div>
      <div class="area-grid">
        <article>
          <span>01</span>
          <h3>Perto do centro</h3>
          <p>Ideal para restaurantes, cafés, pequenos comércios e passeios à noite sem precisar de transporte. Pergunte sobre o ruído da rua e o percurso exato a pé.</p>
          <strong>Bom para: primeira visita, casais e grupos sociáveis</strong>
        </article>
        <article>
          <span>02</span>
          <h3>Condomínios à beira-mar</h3>
          <p>Acesso direto ou muito próximo à areia, piscinas compartilhadas, jardins e a praticidade de um apartamento. Confirme se “vista para o mar” também significa acesso fácil à praia.</p>
          <strong>Bom para: dias de praia, grupos menores e praticidade</strong>
        </article>
        <article>
          <span>03</span>
          <h3>Casas privativas</h3>
          <p>Mais independência, cozinha, áreas externas e espaço para se acomodar. Localização, estacionamento, piscina e distância a pé variam bastante.</p>
          <strong>Bom para: famílias, estadias longas e privacidade</strong>
        </article>
        <article>
          <span>04</span>
          <h3>Vilas espaçosas</h3>
          <p>Vários quartos e amplas áreas de convivência permitem que amigos e famílias grandes fiquem juntos sem abrir mão do espaço individual.</p>
          <strong>Bom para: comemorações, grupos e férias em família</strong>
        </article>
      </div>
    </div>
  </section>

  <section class="section choice-section">
    <div class="shell choice-grid">
      <div>
        <p class="eyebrow">Antes de escolher</p>
        <h2>Seis perguntas para evitar uma reserva inadequada.</h2>
        <ol class="question-list">
          <li><strong>Com que frequência vocês irão ao centro a pé?</strong><span>A praticidade diária pode valer mais do que uma comodidade adicional.</span></li>
          <li><strong>Vocês precisam de acesso verdadeiro à praia?</strong><span>Vista para o mar, proximidade e um portão direto para a areia são coisas diferentes.</span></li>
          <li><strong>Como todos irão dormir?</strong><span>Conte camas adequadas e quartos úteis, não apenas a capacidade máxima.</span></li>
          <li><strong>Levarão equipamento de kite?</strong><span>Pergunte sobre armazenamento, lavagem, secagem, transporte e orientação para entrar na água.</span></li>
          <li><strong>Alguém tem mobilidade reduzida?</strong><span>Verifique escadas, elevadores, entradas, banheiros e o caminho fora do imóvel.</span></li>
          <li><strong>O que precisa ser privativo?</strong><span>Confirme piscinas, jardins, entradas, estacionamento e áreas compartilhadas do condomínio.</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Três opções diferentes</p>
          <h2>Compare os estilos de hospedagem.</h2>
        </div>
        <a class="button button--ghost" href="/properties/">Ver todos os imóveis em Cumbuco</a>
      </div>
      <div class="property-grid">{examples.map((property) => <PropertyCard property={property} />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="shell match-grid">
      <div>
        <p class="eyebrow">Peça uma recomendação pessoal</p>
        <h2>Conte como você imagina suas férias.</h2>
      </div>
      <div class="prose">
        <p>Informe as datas, o número de hóspedes e quartos, a faixa de orçamento, os planos de transporte e as atividades mais importantes. Compararemos os imóveis disponíveis para encontrar a opção mais adequada ao grupo.</p>
        <div class="actions">
          <a class="button" href="/contact-cumbuco-rentals/">Pedir orientação</a>
          <a class="button button--ghost" href="/city/cumbuco/travel-information/">Planejar a viagem</a>
        </div>
      </div>
    </div>
  </section>

  <BusinessHighlights
    categories={["hotel", "pousada"]}
    eyebrow="Outras hospedagens"
    title="Contatos locais de hospedagem."
    description="Se nossos imóveis não forem a opção ideal, estas hospedagens locais oferecem alternativas que vale a pena comparar."
  />

  <section class="section faq-section">
    <div class="shell">
      <p class="eyebrow">Perguntas frequentes</p>
      <h2>Como escolher onde ficar em Cumbuco.</h2>
      <div class="faq-grid">
        {faqItems.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sub-hero { position: relative; min-height: 36rem; display: grid; align-items: end; overflow: hidden; color: white; background: var(--ocean-deep); }
  .sub-hero picture, .sub-hero picture img, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sub-hero img { object-fit: cover; object-position: center 52%; }
  .shade { background: linear-gradient(90deg, rgb(3 43 45 / 68%), rgb(3 43 45 / 34%) 46%, rgb(3 43 45 / 5%) 74%), linear-gradient(0deg, rgb(3 35 38 / 36%), transparent 54%); }
  .hero-copy { position: relative; z-index: 1; width: min(var(--content), calc(100% - clamp(2rem, 8vw, 10rem))); margin-left: clamp(1rem, 4vw, 5rem); margin-right: auto; padding-block: clamp(4rem, 9vw, 7rem); }
  .hero-copy h1 { max-width: 13ch; text-shadow: 0 0.2rem 1.5rem rgb(0 24 27 / 36%); }
  .hero-copy > p:last-child { max-width: 48rem; margin-top: 1.15rem; font-size: clamp(1.05rem, 2vw, 1.3rem); text-shadow: 0 0.12rem 0.8rem rgb(0 24 27 / 48%); }
  .hero-copy .eyebrow { color: #ffd46c; }

  .intro-grid, .match-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(3rem, 8vw, 7rem); align-items: start; }
  .intro-grid h2, .match-grid h2 { max-width: 14ch; }
  .section-intro { max-width: 35rem; color: var(--ink-soft); }
  .context-link { color: var(--ocean); font-weight: 900; text-decoration-thickness: 0.08em; text-underline-offset: 0.22em; }
  .area-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 2.5rem; border-block: 1px solid var(--line); }
  .area-grid article { padding: 1.75rem; border-right: 1px solid var(--line); }
  .area-grid article:last-child { border-right: 0; }
  .area-grid span { color: var(--coral); font-size: 0.74rem; font-weight: 800; }
  .area-grid h3 { margin-top: 2.2rem; }
  .area-grid p { margin-top: 0.8rem; color: var(--ink-soft); }
  .area-grid strong { display: block; margin-top: 1.25rem; color: var(--ocean); font-size: 0.8rem; }

  .choice-grid { display: grid; grid-template-columns: minmax(0, 52rem); justify-content: center; }
  .choice-image picture { display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 1.4rem; box-shadow: var(--shadow); }
  .choice-image img { width: 100%; height: 100%; object-fit: cover; }
  .choice-grid h2 { max-width: 13ch; }
  .question-list { display: grid; gap: 0; margin: 2rem 0 0; padding: 0; list-style: none; counter-reset: choices; }
  .question-list li { position: relative; display: grid; gap: 0.25rem; padding: 1rem 0 1rem 2.7rem; border-top: 1px solid var(--line); counter-increment: choices; }
  .question-list li::before { position: absolute; top: 1rem; left: 0; color: var(--coral); content: "0" counter(choices); font-family: "Fraunces", Georgia, serif; font-size: 1.25rem; }
  .question-list span { color: var(--ink-soft); font-size: 0.9rem; }

  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .faq-section { border-top: 1px solid var(--line); }
  .faq-section h2 { max-width: 15ch; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .faq-grid article { padding: 1.75rem 1.75rem 1.75rem 0; border-bottom: 1px solid var(--line); }
  .faq-grid article:nth-child(odd) { border-right: 1px solid var(--line); }
  .faq-grid article:nth-child(even) { padding-left: 1.75rem; }
  .faq-grid h3 { font-size: 1.25rem; }
  .faq-grid p { margin-top: 0.7rem; color: var(--ink-soft); }

  @media (max-width: 900px) {
    .area-grid { grid-template-columns: 1fr 1fr; }
    .area-grid article:nth-child(2) { border-right: 0; }
    .area-grid article:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }

  @media (max-width: 720px) {
    .sub-hero { min-height: 32rem; }
    .intro-grid, .choice-grid, .match-grid, .faq-grid { grid-template-columns: 1fr; }
    .choice-image picture { aspect-ratio: 16 / 10; }
    .faq-grid article, .faq-grid article:nth-child(even) { padding: 1.35rem 0; border-right: 0; }
  }

  @media (max-width: 520px) {
    .area-grid { grid-template-columns: 1fr; }
    .area-grid article { border-right: 0; border-bottom: 1px solid var(--line); }
    .area-grid article:last-child { border-bottom: 0; }
  }
</style>
