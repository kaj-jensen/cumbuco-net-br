---
import BusinessHighlights from "../../../components/BusinessHighlights.astro";
import DestinationGuideNav from "../../../components/DestinationGuideNav.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "Kitesurf em Cumbuco: Temporada de Vento, Aulas e Segurança";
const description = "Planeje sua viagem de kitesurf a Cumbuco: temporada de vento, aulas, condições de praia e lagoa, equipamento, downwind, segurança e hospedagem.";
const image = "/images/content/cumbuco/kitesurfing-1440.jpg";
const faqItems = [
  { question: "When is the best wind season in Cumbuco?", answer: "The core season normally runs from July through December, with useful trade-wind conditions often continuing into January. Daily strength, direction, tide, and sea state still require a current local check." },
  { question: "Is Cumbuco suitable for beginner kiteboarders?", answer: "Yes when beginners learn with a qualified school that selects the location, equipment, and lesson plan for the student and current conditions. A famous kite destination is not automatically safe for unsupervised learning." },
  { question: "Should I bring my own kite equipment?", answer: "Experienced riders staying for several days often value their own equipment, but airlines, transfers, storage, and the range of kite sizes need planning. Beginners are usually better served by lesson equipment chosen by the school." },
  { question: "Can I do a downwinder from Cumbuco?", answer: "Experienced independent riders can join supported downwind trips, but route knowledge, changing conditions, landing options, communication, and vehicle support matter. Book an established local service and be honest about your level." },
];
const structuredData = [
  { "@type": "Article", "@id": "https://www.cumbuco.net.br/city/cumbuco/kiteboarding/#article", headline: title, description, image: new URL(image, Astro.site).toString(), about: { "@type": "SportsActivityLocation", name: "Área de kitesurf em Cumbuco", address: { "@type": "PostalAddress", addressLocality: "Cumbuco", addressRegion: "Ceará", addressCountry: "BR" } }, publisher: { "@id": "https://www.cumbuco.net.br/#organization" }, inLanguage: "pt-BR" },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://www.cumbuco.net.br/" },
    { "@type": "ListItem", position: 2, name: "Guia de Cumbuco", item: "https://www.cumbuco.net.br/city/cumbuco/" },
    { "@type": "ListItem", position: 3, name: "Kitesurf", item: "https://www.cumbuco.net.br/city/cumbuco/kiteboarding/" },
  ]},
  { "@type": "FAQPage", mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
];
---

<BaseLayout title={title} description={description} canonical="/city/cumbuco/kiteboarding/" image={image} structuredData={structuredData}>
  <section class="sub-hero">
    <picture>
      <source type="image/avif" srcset="/images/content/cumbuco/kitesurfing-720.avif 720w, /images/content/cumbuco/kitesurfing-1440.avif 1440w" sizes="100vw" />
      <source type="image/webp" srcset="/images/content/cumbuco/kitesurfing-720.webp 720w, /images/content/cumbuco/kitesurfing-1440.webp 1440w" sizes="100vw" />
      <img src={image} srcset="/images/content/cumbuco/kitesurfing-720.jpg 720w, /images/content/cumbuco/kitesurfing-1440.jpg 1440w" sizes="100vw" width="1440" height="1080" alt="Kiteboarder riding the Atlantic wind at Cumbuco Beach" fetchpriority="high" />
    </picture>
    <div class="shade"></div>
    <div class="shell hero-copy">
      <p class="eyebrow">Kitesurf em Cumbuco</p>
      <h1>Venha pelos ventos alísios. Navegue com responsabilidade.</h1>
      <p>Cumbuco conquistou fama mundial pela água quente, praias extensas, ventos sazonais fortes e variedade de condições — não pela promessa de que todos os dias servem para todos os velejadores.</p>
    </div>
  </section>

  <DestinationGuideNav current="kiteboarding" />

  <section class="facts">
    <div class="shell fact-grid"><p><strong>July–December</strong><span>core wind season</span></p><p><strong>Warm water</strong><span>throughout the year</span></p><p><strong>Beach + lagoons</strong><span>different skills and conditions</span></p><p><strong>Lessons first</strong><span>for every new rider</span></p></div>
  </section>

  <section class="section">
    <div class="shell intro-grid">
      <div><p class="eyebrow">Why riders return</p><h2>A serious kite base with an easy village around it.</h2></div>
      <div class="prose"><p>The coast of Ceará receives steady trade winds in the second half of the year. Cumbuco adds warm Atlantic water, a long shoreline, lagoons within the wider area, qualified schools, repair and rental services, and a community organised around time on the water.</p><p>That variety is the strength—and the reason not to reduce Cumbuco to one “perfect spot.” Beach chop, waves, tide, crowds, freshwater depth, and wind quality change. Good riders and good schools choose the session that fits the day.</p></div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Choose by experience</p><h2>Match ambition to ability.</h2></div><p class="section-intro">Your independent riding level matters more than how long you have owned equipment.</p></div>
      <div class="level-grid">
        <article><span>New to kiteboarding</span><h3>Book a complete lesson pathway</h3><p>Start with site assessment, equipment, safety systems, kite control, and assisted practice. Do not buy a board and ask a friend for a quick launch.</p><strong>Priority: qualified instruction</strong></article>
        <article><span>Progressing rider</span><h3>Use coaching to unlock the destination</h3><p>A school can select flatter or more forgiving conditions, refine transitions and upwind riding, and assess whether independent beach sessions are appropriate.</p><strong>Priority: honest level assessment</strong></article>
        <article><span>Independent rider</span><h3>Check the spot every session</h3><p>Understand local launch zones, hazards, tide, crowd patterns, right-of-way, equipment needs, and safe alternatives before rigging.</p><strong>Priority: local briefing</strong></article>
        <article><span>Advanced traveller</span><h3>Treat downwinders as expeditions</h3><p>Long coastal routes require reliable self-rescue skills, route knowledge, communication, landing options, weather judgement, and vehicle support.</p><strong>Priority: established local support</strong></article>
      </div>
    </div>
  </section>

  <section class="section season-section">
    <div class="shell season-grid">
      <picture>
        <source type="image/avif" srcset="/images/content/cumbuco/sunny-kitesurfing-720.avif 720w, /images/content/cumbuco/sunny-kitesurfing-1440.avif 1440w" sizes="(max-width: 760px) 100vw, 52vw" />
        <source type="image/webp" srcset="/images/content/cumbuco/sunny-kitesurfing-720.webp 720w, /images/content/cumbuco/sunny-kitesurfing-1440.webp 1440w" sizes="(max-width: 760px) 100vw, 52vw" />
        <img src="/images/content/cumbuco/sunny-kitesurfing-1440.jpg" srcset="/images/content/cumbuco/sunny-kitesurfing-720.jpg 720w, /images/content/cumbuco/sunny-kitesurfing-1440.jpg 1440w" sizes="(max-width: 760px) 100vw, 52vw" width="1440" height="1080" loading="lazy" alt="Colourful kites in the clear sky above Cumbuco Beach" />
      </picture>
      <div>
        <p class="eyebrow">Wind through the year</p><h2>Plan for a season, then read the day.</h2>
        <div class="timeline">
          <article><span>Jul–Aug</span><p>Trade winds become established as the rainy period recedes. A strong opening to the season with somewhat less peak-month pressure.</p></article>
          <article><span>Sep–Nov</span><p>The heart of international kite season: generally the most reliable wind, busiest schools, and strongest accommodation demand.</p></article>
          <article><span>Dec–Jan</span><p>Warm holiday energy and often useful wind, though reliability can ease as January advances.</p></article>
          <article><span>Feb–Jun</span><p>More variable wind and the principal rainy period from February to May. Travel can still be rewarding, but not as a guaranteed kite holiday.</p></article>
        </div>
        <p class="source-note">Visit Brasil describes steady Ceará winds from July to January. FUNCEME identifies February–May as Ceará's principal rainy period. Neither replaces a daily marine and spot assessment.</p>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell conditions-grid">
      <div><p class="eyebrow">Beach or lagoon?</p><h2>Different water asks different questions.</h2></div>
      <div class="condition-cards">
        <article><h3>Atlantic beach</h3><p>Expect moving water, shore break or waves, tide, chop, swimmers, other riders, and a wind-affected launch. The exact character changes along the shoreline.</p><ul><li>Ask where riders should rig and launch</li><li>Respect swimmers and beach users</li><li>Check tide and downwind clearance</li></ul></article>
        <article><h3>Freshwater lagoon</h3><p>Flatter water can look easier, but shallow areas, gusts, crowds, changing depth, obstacles, and limited space create their own risks.</p><ul><li>Confirm current water level</li><li>Understand circulation and priority</li><li>Do not assume “flat” means beginner-safe</li></ul></article>
      </div>
    </div>
  </section>

  <section class="section safety-section">
    <div class="shell safety-grid">
      <div><p class="eyebrow">Non-negotiable</p><h2>Safety is part of the sport, not a disclaimer.</h2><p>The International Kiteboarding Organization's beginner pathway starts with assessing the spot and environment, equipment set-up, safety systems, pre-flight checks, and assisted launching and landing before independent riding.</p><a class="text-link" href="https://www.ikointl.com/course/kiteboarder/discovery" target="_blank" rel="noopener noreferrer">See the IKO beginner pathway ↗</a></div>
      <ol>
        <li><strong>Take qualified instruction.</strong><span>Friends and videos do not replace a trained instructor and a structured progression.</span></li>
        <li><strong>Inspect equipment and safety systems.</strong><span>Use the right size and configuration for your level, weight, and the actual conditions.</span></li>
        <li><strong>Keep a clear launch and landing zone.</strong><span>Lines, people, buildings, vehicles, trees, and downwind obstacles require distance.</span></li>
        <li><strong>Never ride beyond your recovery plan.</strong><span>Know self-rescue, where you can land, and how help would reach you.</span></li>
        <li><strong>Stop before judgement fades.</strong><span>Heat, dehydration, fatigue, and overconfidence can turn a good session into a poor decision.</span></li>
      </ol>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell logistics-grid">
      <div><p class="eyebrow">Kite-trip logistics</p><h2>Make the equipment easy before arrival.</h2></div>
      <div class="logistics-list">
        <article><h3>Flying with gear</h3><p>Check airline dimensions, weight rules, sports-equipment fees, connections, and damage coverage before buying the ticket.</p></article>
        <article><h3>Airport transfer</h3><p>Send the number and dimensions of bags in advance. A vehicle that fits four passengers may not fit four passengers plus board bags.</p></article>
        <article><h3>Rental storage</h3><p>Ask where equipment can be stored, rinsed, and dried, and whether carrying it to the beach requires stairs, gates, or transport.</p></article>
        <article><h3>Repair and rental</h3><p>Confirm current local availability before relying on a specific kite size, board type, spare part, or same-day repair.</p></article>
      </div>
    </div>
  </section>

  <BusinessHighlights
    categories={["kite-school"]}
    eyebrow="Schools to contact directly"
    title="Start with a current kite-school shortlist."
    description="Compare the lesson approach, current availability, certification, languages, and launch conditions directly before booking."
  />

  <section class="section cta">
    <div class="shell cta-grid">
      <div><p class="eyebrow">Choose a kite-friendly base</p><h2>Beach access is only one part of the stay.</h2></div>
      <div><p>Storage, rinsing, drying, transfers, walking distance, non-rider comfort, and the right sleeping arrangement matter every day.</p><div class="actions"><a class="button" href="/city/cumbuco/where-to-stay/">Where to stay</a><a class="button button--ghost" href="/contact-cumbuco-rentals/">Ask for a rental match</a></div></div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="shell"><p class="eyebrow">Kite-trip questions</p><h2>Before packing the board bag.</h2><div class="faq-grid">{faqItems.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></div>
  </section>
</BaseLayout>

<style>
  .sub-hero { position: relative; min-height: 35rem; display: grid; align-items: end; overflow: hidden; color: white; }
  .sub-hero picture, .sub-hero picture img, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sub-hero img { object-fit: cover; object-position: center 52%; }
  .shade { background: linear-gradient(90deg, rgb(3 43 45 / 84%), rgb(3 43 45 / 34%) 64%, rgb(3 43 45 / 6%)), linear-gradient(0deg, rgb(3 35 38 / 54%), transparent 58%); }
  .hero-copy { position: relative; padding-block: clamp(3.5rem, 8vw, 6rem); }
  .hero-copy h1 { max-width: 12ch; }
  .hero-copy > p:last-child { max-width: 46rem; margin-top: 1.1rem; font-size: clamp(1.05rem, 2vw, 1.28rem); }
  .hero-copy .eyebrow { color: #ffd46c; }
  .facts { background: var(--ocean); color: white; }
  .fact-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .fact-grid p { display: grid; gap: .15rem; padding: 1rem 1.5rem; border-right: 1px solid rgb(255 255 255 / 16%); }
  .fact-grid p:first-child { padding-left: 0; }
  .fact-grid p:last-child { border-right: 0; }
  .fact-grid strong { color: #ffd46c; }
  .fact-grid span { color: rgb(255 255 255 / 74%); font-size: .8rem; }
  .intro-grid, .conditions-grid, .logistics-grid, .cta-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 7rem); }
  .intro-grid h2, .conditions-grid h2, .logistics-grid h2, .cta-grid h2 { max-width: 13ch; }
  .section-intro { max-width: 34rem; color: var(--ink-soft); }
  .level-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 2rem; border-block: 1px solid var(--line); }
  .level-grid article { display: flex; flex-direction: column; padding: 1.5rem; border-right: 1px solid var(--line); }
  .level-grid article:last-child { border-right: 0; }
  .level-grid span { color: var(--coral); font-size: .78rem; font-weight: 800; }
  .level-grid h3 { margin-top: 2rem; }
  .level-grid p { margin-top: .7rem; color: var(--ink-soft); }
  .level-grid strong { margin-top: auto; padding-top: 1rem; color: var(--ocean); font-size: .8rem; }
  .season-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2.5rem, 7vw, 6rem); align-items: center; }
  .season-grid picture { display: block; aspect-ratio: 5/4; overflow: hidden; border-radius: 1.4rem; box-shadow: var(--shadow); }
  .season-grid img { width: 100%; height: 100%; object-fit: cover; }
  .season-grid h2 { max-width: 12ch; }
  .timeline { margin-top: 1.2rem; border-top: 1px solid var(--line); }
  .timeline article { display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid var(--line); }
  .timeline span { color: var(--coral); font-weight: 800; }
  .timeline p, .source-note, .cta-grid p { color: var(--ink-soft); }
  .source-note { margin-top: 1rem; font-size: .85rem; }
  .condition-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .condition-cards article { padding: 1.5rem; background: var(--paper); border: 1px solid var(--line); border-radius: 1rem; }
  .condition-cards p { margin-top: .6rem; color: var(--ink-soft); }
  .condition-cards ul { margin: 1rem 0 0; padding-left: 1.1rem; color: var(--ink-soft); }
  .safety-section { background: var(--ocean); color: white; }
  .safety-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 7rem); }
  .safety-grid h2 { max-width: 12ch; }
  .safety-grid > div > p:not(.eyebrow) { margin-top: 1rem; color: rgb(255 255 255 / 78%); }
  .safety-grid .text-link { display: inline-block; margin-top: 1rem; color: #ffd46c; font-weight: 800; text-decoration: none; }
  .safety-grid ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgb(255 255 255 / 20%); }
  .safety-grid li { display: grid; gap: .25rem; padding: .9rem 0; border-bottom: 1px solid rgb(255 255 255 / 20%); }
  .safety-grid li span { color: rgb(255 255 255 / 72%); }
  .logistics-list { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .logistics-list article { padding: 1.2rem 1.2rem 1.2rem 0; border-bottom: 1px solid var(--line); }
  .logistics-list article:nth-child(even) { padding-left: 1.2rem; border-left: 1px solid var(--line); }
  .logistics-list p { margin-top: .5rem; color: var(--ink-soft); }
  .cta { background: var(--seafoam); }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.25rem; }
  .faq-section { border-top: 1px solid var(--line); }
  .faq-section h2 { max-width: 14ch; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 2rem; border-top: 1px solid var(--line); }
  .faq-grid article { padding: 1.5rem 1.5rem 1.5rem 0; border-bottom: 1px solid var(--line); }
  .faq-grid article:nth-child(odd) { border-right: 1px solid var(--line); }
  .faq-grid article:nth-child(even) { padding-left: 1.5rem; }
  .faq-grid h3 { font-size: 1.2rem; }
  .faq-grid p { margin-top: .6rem; color: var(--ink-soft); }
  @media (max-width: 850px) { .level-grid { grid-template-columns: 1fr 1fr; } .level-grid article:nth-child(2) { border-right: 0; } .level-grid article:nth-child(-n+2) { border-bottom: 1px solid var(--line); } }
  @media (max-width: 720px) { .sub-hero { min-height: 32rem; } .fact-grid { grid-template-columns: 1fr 1fr; } .fact-grid p { padding: .8rem 0; border-right: 0; border-bottom: 1px solid rgb(255 255 255 / 14%); } .fact-grid p:nth-child(odd) { padding-right: 1rem; } .intro-grid, .season-grid, .conditions-grid, .safety-grid, .logistics-grid, .cta-grid, .faq-grid { grid-template-columns: 1fr; } .faq-grid article, .faq-grid article:nth-child(even) { padding: 1.25rem 0; border-right: 0; } }
  @media (max-width: 520px) { .level-grid, .condition-cards, .logistics-list { grid-template-columns: 1fr; } .level-grid article { border-right: 0; border-bottom: 1px solid var(--line); } .logistics-list article, .logistics-list article:nth-child(even) { padding: 1rem 0; border-left: 0; } }
</style>
