---
import { getCollection } from "astro:content";
import PropertyArchive from "../../components/PropertyArchive.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { brazilianPropertySlugs, comparePropertyEntries } from "../../config/site";
const properties = (await getCollection("properties")).filter((item) => brazilianPropertySlugs.has(item.data.slug)).sort(comparePropertyEntries);
---
<BaseLayout title="Imóveis para aluguel em Cumbuco: casas e apartamentos" description="Encontre casas, villas e apartamentos para aluguel por temporada em Cumbuco, Ceará, com atendimento pessoal pelo WhatsApp.">
  <PropertyArchive properties={properties} title="Imóveis feitos para viver Cumbuco." description="De villas privativas para toda a família a apartamentos perto da praia, conheça nossa seleção local de imóveis por temporada." showDestinationLink={true} />
  <section class="section section--sand"><div class="shell seo-path"><div><p class="eyebrow">Procurando uma casa?</p><h2>Compare casas de praia com piscina em Cumbuco.</h2></div><a class="button button--ghost" href="/casas-de-praia-cumbuco/">Ver casas e villas</a></div></section>
</BaseLayout>

<style>.seo-path { display: flex; align-items: end; justify-content: space-between; gap: 2rem; } .seo-path h2 { max-width: 18ch; } @media (max-width: 620px) { .seo-path { align-items: start; flex-direction: column; } }</style>
