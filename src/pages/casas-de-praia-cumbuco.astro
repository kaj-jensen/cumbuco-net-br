---
import { getCollection } from "astro:content";
import PropertyCard from "../components/PropertyCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { brazilianPropertySlugs, comparePropertyEntries } from "../config/site";

const allProperties = (await getCollection("properties"))
  .filter((item) => brazilianPropertySlugs.has(item.data.slug))
  .sort(comparePropertyEntries);
const houses = allProperties.filter(({ data }) => data.propertyType === "house" || data.propertyType === "villa");
const apartments = allProperties.filter(({ data }) => data.propertyType === "apartment" && data.features.includes("Piscina"));
const pageUrl = new URL("/casas-de-praia-cumbuco/", Astro.site).toString();
const structuredData = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Cumbuco Aluguéis", item: "https://www.cumbuco.net.br/" },
      { "@type": "ListItem", position: 2, name: "Imóveis", item: "https://www.cumbuco.net.br/properties/" },
      { "@type": "ListItem", position: 3, name: "Casas de praia em Cumbuco", item: pageUrl },
    ],
  },
  {
    "@type": "ItemList",
    name: "Casas de praia para alugar em Cumbuco",
    itemListElement: houses.map(({ data }, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: data.title,
      url: new URL(`/properties/${data.slug}/`, Astro.site).toString(),
    })),
  },
  {
    "@type": "FAQPage",
    mainEntity: [
      { "@type": "Question", name: "Há casas para alugar em Cumbuco com piscina?", acceptedAnswer: { "@type": "Answer", text: "Sim. A seleção inclui casas e villas com piscina, além de apartamentos em condomínios com piscina." } },
      { "@type": "Question", name: "Como consultar a disponibilidade das casas?", acceptedAnswer: { "@type": "Answer", text: "Abra o imóvel, consulte o calendário e envie as datas, o número de hóspedes e seu nome pelo WhatsApp ou formulário." } },
      { "@type": "Question", name: "Há casas grandes para grupos em Cumbuco?", acceptedAnswer: { "@type": "Answer", text: "Sim. A Villa Branca acomoda até 20 hóspedes e a Casa Chick até 14, sempre com confirmação pessoal de disponibilidade e condições." } },
    ],
  },
];
---

<BaseLayout
  title="Casas de praia em Cumbuco para alugar com piscina"
  description="Casas de praia, villas e imóveis com piscina para aluguel por temporada em Cumbuco. Compare capacidade, localização e disponibilidade com atendimento local."
  canonical="/casas-de-praia-cumbuco/"
  image={houses[0].data.gallery[0].src}
  imageAlt="Casa de praia com piscina para aluguel em Cumbuco"
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <section class="landing-hero section--sand">
    <div class="shell landing-hero__grid">
      <div>
        <p class="eyebrow">Aluguel por temporada em Cumbuco</p>
        <h1>Casas de praia em Cumbuco para viver dias inteiros juntos.</h1>
      </div>
      <div class="hero-copy">
        <p>Compare casas e villas com piscina para famílias e grupos, desde imóveis independentes até uma villa frente ao mar. Cada página mostra capacidade, fotos, comodidades e calendário antes do contato.</p>
        <div class="hero-actions"><a class="button" href="#casas">Ver casas disponíveis</a><a class="text-link" href="/contact-cumbuco-rentals/">Pedir orientação local →</a></div>
      </div>
    </div>
  </section>

  <section id="casas" class="section">
    <div class="shell">
      <header class="section-heading">
        <div><p class="eyebrow">Casas e villas</p><h2>Escolha pelo tamanho e pelo estilo da estadia.</h2></div>
        <p>Villa Branca aparece primeiro por reunir seis suítes, piscina, jardim e localização frente ao mar.</p>
      </header>
      <div class="property-grid">{houses.map((property) => <PropertyCard property={property} />)}</div>
    </div>
  </section>

  <section class="section section--ocean decision">
    <div class="shell decision-grid">
      <div><p class="eyebrow">Como escolher</p><h2>A casa certa começa pelo grupo, não pela foto.</h2></div>
      <div class="decision-points">
        <article><span>01</span><h3>Defina quem viaja</h3><p>Conte adultos, crianças e necessidades de mobilidade antes de comparar quartos.</p></article>
        <article><span>02</span><h3>Escolha a localização</h3><p>Frente ao mar, perto da vila ou em condomínio: cada base muda o ritmo da viagem.</p></article>
        <article><span>03</span><h3>Confira o custo completo</h3><p>Confirmamos datas, valor e serviços opcionais pessoalmente antes de qualquer decisão.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell">
      <header class="section-heading">
        <div><p class="eyebrow">Também com piscina</p><h2>Apartamentos para grupos menores.</h2></div>
        <p>Para até quatro hóspedes, um apartamento pode oferecer piscina e praticidade sem o espaço de uma casa inteira.</p>
      </header>
      <div class="property-grid property-grid--apartments">{apartments.map((property) => <PropertyCard property={property} />)}</div>
    </div>
  </section>

  <section class="section faq">
    <div class="shell faq-grid">
      <div><p class="eyebrow">Perguntas frequentes</p><h2>Antes de consultar uma casa em Cumbuco.</h2></div>
      <div>
        <details open><summary>Há casas com piscina?</summary><p>Sim. As casas e villas desta seleção informam a piscina entre as comodidades. Os apartamentos apresentados também ficam em empreendimentos com piscina.</p></details>
        <details><summary>Como vejo datas futuras?</summary><p>Abra a página do imóvel e use “Ver calendário completo”. É possível navegar e selecionar datas até dois anos à frente.</p></details>
        <details><summary>Posso pedir ajuda para escolher?</summary><p>Sim. Envie datas, número de hóspedes e prioridades. O atendimento local ajuda a comparar as opções antes da cotação.</p></details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .landing-hero { padding-block: clamp(4rem, 9vw, 8rem); }
  .landing-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr); gap: clamp(2rem, 8vw, 8rem); align-items: end; }
  h1 { max-width: 15ch; font-size: clamp(3rem, 6vw, 6rem); }
  .hero-copy { padding-bottom: 0.5rem; }
  .hero-copy > p { color: var(--ink-soft); font-size: 1.05rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 1.5rem; }
  .section-heading > p { max-width: 34rem; color: var(--ink-soft); }
  .decision-grid { display: grid; grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr); gap: clamp(2rem, 8vw, 7rem); }
  .decision-grid h2 { max-width: 11ch; }
  .decision-points { display: grid; gap: 0; }
  .decision-points article { display: grid; grid-template-columns: 3rem 1fr; gap: 0.3rem 1rem; padding: 1.35rem 0; border-top: 1px solid rgb(255 255 255 / 18%); }
  .decision-points span { grid-row: 1 / 3; color: var(--sun); font-family: "Fraunces", Georgia, serif; font-size: 1.5rem; }
  .decision-points h3 { color: white; font-size: 1.2rem; }
  .decision-points p { color: #dcebea; font-size: 0.9rem; }
  .faq-grid { display: grid; grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 8vw, 7rem); }
  .faq-grid h2 { max-width: 12ch; }
  details { padding: 1.1rem 0; border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { color: var(--ocean-deep); font-weight: 900; cursor: pointer; }
  details p { max-width: 42rem; margin-top: 0.7rem; color: var(--ink-soft); }
  @media (max-width: 780px) { .landing-hero__grid, .decision-grid, .faq-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; flex-direction: column; } }
</style>
