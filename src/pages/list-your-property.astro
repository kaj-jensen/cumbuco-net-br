---
import BaseLayout from "../layouts/BaseLayout.astro";

const ownerEmail =
  "mailto:info@cumbuco.net?subject=Quero%20anunciar%20meu%20imovel%20em%20Cumbuco";
const ownerWhatsApp =
  "https://wa.me/5585988139402?text=Ola%2C%20gostaria%20de%20conversar%20sobre%20anunciar%20meu%20imovel%20em%20Cumbuco.";
const hero = "/images/content/cumbuco/sunny-beach-1440.jpg";

const benefits = [
  {
    number: "01",
    title: "Anúncio sem custo inicial",
    text: "Não cobramos taxa para preparar e publicar o imóvel. As condições comerciais são combinadas antes do início da parceria.",
  },
  {
    number: "02",
    title: "Apresentação profissional",
    text: "Visitamos o imóvel, selecionamos as fotografias e escrevemos uma descrição clara para o hóspede entender o que está reservando.",
  },
  {
    number: "03",
    title: "Divulgação feita por nós",
    text: "Publicamos e divulgamos o imóvel em nossos canais enquanto você mantém o controle sobre disponibilidade e condições.",
  },
  {
    number: "04",
    title: "Conhecimento de Cumbuco",
    text: "Conhecemos a vila, as temporadas, as dúvidas dos hóspedes e o perfil de viagem que combina com cada imóvel.",
  },
  {
    number: "05",
    title: "Atendimento pessoal",
    text: "Respondemos cada consulta, esclarecemos as dúvidas e avaliamos a estadia antes de qualquer confirmação.",
  },
  {
    number: "06",
    title: "Processo acompanhado",
    text: "Organizamos os dados da reserva e o sinal combinado, trazendo mais clareza para proprietário e hóspede.",
  },
];

const steps = [
  {
    title: "Começamos pela conversa",
    text: "Conte sobre o imóvel, a localização, a disponibilidade e o que espera de uma parceria de locação.",
  },
  {
    title: "Preparamos a apresentação",
    text: "Visitamos, fotografamos e escrevemos o anúncio. O proprietário não precisa montar nem administrar a página.",
  },
  {
    title: "Divulgamos o imóvel",
    text: "O imóvel entra no Cumbuco Aluguéis e nos canais adequados para alcançar hóspedes compatíveis.",
  },
  {
    title: "Avaliamos cada consulta",
    text: "Conversamos com o hóspede, esclarecemos a estadia, organizamos o sinal e só então confirmamos a reserva.",
  },
  {
    title: "Acompanhamos a reserva",
    text: "Depois da sua aprovação, cuidamos da comunicação com o hóspede e dos detalhes combinados.",
  },
];

const faqs = [
  {
    question: "Anunciar o imóvel realmente não tem custo inicial?",
    answer:
      "Sim. Não cobramos pela visita, preparação das fotos, descrição ou publicação. As condições comerciais da locação são explicadas antes de você decidir continuar.",
  },
  {
    question: "Posso continuar anunciando no Airbnb ou Booking.com?",
    answer:
      "Sim. A parceria não impede o uso de outros canais. A disponibilidade precisa estar atualizada para evitar reservas conflitantes.",
  },
  {
    question: "Quem define o valor da locação?",
    answer:
      "Você aprova valores e condições antes da divulgação. Podemos conversar sobre mercado e posicionamento, mas nada é publicado sem seu acordo.",
  },
  {
    question: "Quem atende os possíveis hóspedes?",
    answer:
      "O Cumbuco Aluguéis atende as consultas, responde às perguntas e conversa sobre a estadia antes da aceitação da reserva.",
  },
  {
    question: "Como a reserva é confirmada?",
    answer:
      "A reserva só é confirmada depois da avaliação do pedido, do alinhamento dos detalhes e da organização do sinal combinado.",
  },
  {
    question: "Por que não há reserva instantânea?",
    answer:
      "A análise pessoal permite conferir se o imóvel atende ao grupo e se datas, expectativas e condições estão claras para todos.",
  },
  {
    question: "O que acontece depois do primeiro contato?",
    answer:
      "Começamos com uma conversa sobre o imóvel e suas expectativas. Se houver compatibilidade, marcamos uma visita e explicamos os próximos passos, sem obrigação por iniciar o contato.",
  },
];

const faqStructuredData = {
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<BaseLayout
  title="Anuncie seu Imóvel em Cumbuco | Cumbuco Aluguéis"
  description="Anuncie seu imóvel em Cumbuco sem custo inicial. Preparamos a apresentação, divulgamos e atendemos pessoalmente as consultas de locação."
  canonical="/list-your-property/"
  image={hero}
  structuredData={[faqStructuredData]}
>
  <section class="owner-hero">
    <div class="shell owner-hero__inner">
      <div class="owner-hero__copy">
        <p class="eyebrow">Para proprietários em Cumbuco</p>
        <h1>Seu imóvel bem apresentado e bem atendido.</h1>
        <p>
          Você oferece o imóvel. Nós preparamos o anúncio, divulgamos, conversamos
          com os hóspedes e acompanhamos cada pedido de reserva.
        </p>
        <div class="hero-actions">
          <a class="button button--sun" href="#start-conversation"
            >Falar sobre meu imóvel</a
          >
          <a class="hero-link" href="#how-it-works">Entender como funciona</a>
        </div>
      </div>
      <aside class="hero-card" aria-label="Resumo da parceria">
        <p class="hero-card__label">Parceria local de locação</p>
        <ul>
          <li><strong>Sem custo</strong><span>para preparar e publicar</span></li>
          <li><strong>Completa</strong><span>apresentação e divulgação</span></li>
          <li><strong>Pessoal</strong><span>condições combinadas diretamente</span></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell">
      <div class="section-heading owner-heading">
        <div>
          <p class="eyebrow">Por que trabalhar conosco</p>
          <h2>Um serviço completo, não apenas mais um anúncio.</h2>
        </div>
        <p>
          O proprietário não precisa organizar fotos, escrever o anúncio nem responder
          a cada consulta. O Cumbuco Aluguéis cuida da apresentação e do atendimento.
        </p>
      </div>
      <div class="benefit-grid">
        {
          benefits.map((benefit) => (
            <article class="benefit-card">
              <span>{benefit.number}</span>
              <h3>{benefit.title}</h3>
              <p>{benefit.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section process-section">
    <div class="shell process-layout">
      <div class="process-intro">
        <p class="eyebrow">Como funciona</p>
        <h2>Da primeira visita à reserva confirmada.</h2>
        <p>
          A relação continua pessoal do começo ao fim. Combinamos a forma de trabalho
          e cuidamos da divulgação e do contato com o hóspede.
        </p>
        <picture class="process-image">
          <source type="image/avif" srcset="/images/content/cumbuco/owner-hammock-720.avif 720w, /images/content/cumbuco/owner-hammock-1440.avif 1440w" sizes="(max-width: 720px) 100vw, 42vw" />
          <source type="image/webp" srcset="/images/content/cumbuco/owner-hammock-720.webp 720w, /images/content/cumbuco/owner-hammock-1440.webp 1440w" sizes="(max-width: 720px) 100vw, 42vw" />
          <img src="/images/content/cumbuco/owner-hammock-1440.jpg" srcset="/images/content/cumbuco/owner-hammock-720.jpg 720w, /images/content/cumbuco/owner-hammock-1440.jpg 1440w" sizes="(max-width: 720px) 100vw, 42vw" width="1440" height="960" loading="lazy" decoding="async" alt="Pessoa relaxando anonimamente em uma rede com uma bebida diante do mar" />
        </picture>
      </div>
      <ol class="process-list">
        {
          steps.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--ocean model-section">
    <div class="shell model-layout">
      <div>
        <p class="eyebrow">Começar é simples</p>
        <h2>Preparação profissional sem taxa inicial de anúncio.</h2>
      </div>
      <div class="model-copy">
        <p>
          Visitamos o imóvel, preparamos as fotografias e a descrição e apresentamos
          a propriedade com clareza aos hóspedes adequados.
        </p>
        <p>
          Não há cobrança apenas para publicar. A condição comercial é explicada e
          combinada pessoalmente antes da inclusão no Cumbuco Aluguéis.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell trust-layout">
      <div>
        <p class="eyebrow">Você mantém o controle</p>
        <h2>O imóvel continua sendo seu.</h2>
      </div>
      <div class="trust-grid">
        <article>
          <h3>Sem obrigação de longo prazo</h3>
          <p>Toda parceria começa com uma conversa, não com um compromisso automático.</p>
        </article>
        <article>
          <h3>Valores combinados</h3>
          <p>Você aprova condições e valores antes da divulgação do imóvel.</p>
        </article>
        <article>
          <h3>Sem reservas automáticas</h3>
          <p>Cada hóspede e estadia são avaliados antes da confirmação.</p>
        </article>
        <article>
          <h3>Qualidade antes de quantidade</h3>
          <p>Priorizamos imóveis adequados, apresentação realista e hóspedes compatíveis.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="shell faq-layout">
      <div class="faq-intro">
        <p class="eyebrow">Dúvidas de proprietários</p>
        <h2>Respostas claras antes de decidir.</h2>
        <p>
          Se a sua dúvida não estiver aqui, fale conosco. Preferimos explicar o
          processo corretamente a fazer suposições sobre o imóvel.
        </p>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="start-conversation" class="owner-cta">
    <div class="shell owner-cta__inner">
      <div>
        <p class="eyebrow">Sem obrigação. Apenas uma conversa.</p>
        <h2>Vamos falar sobre seu imóvel.</h2>
        <p>
          Conte sobre o imóvel e o que deseja alcançar. Explicaremos se o Cumbuco
          Aluguéis combina com sua necessidade e qual seria o próximo passo.
        </p>
      </div>
      <div class="cta-actions">
        <a class="button button--sun" href={ownerWhatsApp} target="_blank" rel="noopener noreferrer"
          >Começar pelo WhatsApp</a
        >
        <a class="button button--light" href={ownerEmail}>Enviar e-mail</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .owner-hero {
    position: relative;
    min-height: min(46rem, calc(100vh - 5.25rem));
    display: grid;
    overflow: hidden;
    color: white;
    background: radial-gradient(circle at 80% 18%, rgb(255 212 108 / 28%), transparent 24rem), linear-gradient(135deg, #063f43 0%, #08777a 58%, #75c9bd 100%);
  }
  .owner-hero__picture,
  .owner-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .owner-hero__picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }
  .owner-hero__shade {
    background:
      linear-gradient(90deg, rgb(3 48 52 / 88%) 0%, rgb(3 58 62 / 68%) 48%, rgb(3 54 58 / 26%) 100%),
      linear-gradient(0deg, rgb(3 38 42 / 52%), transparent 58%);
  }
  .owner-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.62fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .owner-hero__copy h1 { max-width: 10ch; }
  .owner-hero__copy > p:not(.eyebrow) {
    max-width: 39rem;
    margin-top: 1.4rem;
    color: rgb(255 255 255 / 86%);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
  }
  .owner-hero .eyebrow { color: #ffd46c; }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    margin-top: 2rem;
  }
  .hero-link {
    color: white;
    font-weight: 700;
    text-decoration: none;
  }
  .hero-link:hover { text-decoration: underline; text-underline-offset: 0.25rem; }
  .hero-card {
    padding: 1.6rem;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius);
    background: rgb(4 67 71 / 78%);
    box-shadow: var(--shadow);
    backdrop-filter: blur(0.75rem);
  }
  .hero-card__label {
    color: #ffd46c;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-card ul { margin: 1rem 0 0; padding: 0; list-style: none; }
  .hero-card li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid rgb(255 255 255 / 16%);
  }
  .hero-card strong { color: white; }
  .hero-card span { color: rgb(255 255 255 / 72%); font-size: 0.87rem; }
  .owner-heading { align-items: start; }
  .owner-heading h2 { max-width: 13ch; }
  .owner-heading > p {
    max-width: 34rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }
  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .benefit-card {
    min-height: 17rem;
    padding: 1.7rem;
    border: 1px solid rgb(6 79 85 / 8%);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 82%);
    box-shadow: 0 0.8rem 2.5rem rgb(6 79 85 / 7%);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  .benefit-card:hover {
    transform: translateY(-0.25rem);
    box-shadow: var(--shadow);
  }
  .benefit-card > span {
    color: var(--coral);
    font-size: 0.72rem;
    font-weight: 800;
  }
  .benefit-card h3 { margin-top: 3rem; }
  .benefit-card p { margin-top: 0.85rem; color: var(--ink-soft); }
  .process-section { background: linear-gradient(145deg, var(--paper), var(--sky)); }
  .process-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.82fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }
  .process-intro { position: sticky; top: 2rem; }
  .process-intro h2 { max-width: 12ch; }
  .process-intro > p:not(.eyebrow) {
    max-width: 34rem;
    margin-top: 1.2rem;
    color: var(--ink-soft);
  }
  .process-image {
    display: block;
    height: 21rem;
    margin-top: 2rem;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .process-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 63%;
  }
  .process-list { margin: 0; padding: 0; list-style: none; counter-reset: process; }
  .process-list li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.5rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
  }
  .process-list li:last-child { border-bottom: 1px solid var(--line); }
  .process-list > li > span {
    color: var(--coral);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.5rem;
  }
  .process-list p { margin-top: 0.65rem; color: var(--ink-soft); }
  .model-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }
  .model-layout h2 { max-width: 12ch; }
  .model-copy {
    display: grid;
    gap: 1.2rem;
    color: rgb(255 255 255 / 82%);
    font-size: 1.05rem;
  }
  .trust-layout {
    display: grid;
    grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.25fr);
    gap: clamp(3rem, 8vw, 7rem);
  }
  .trust-layout h2 { max-width: 10ch; }
  .trust-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .trust-grid article { padding: 1.7rem; border-top: 1px solid var(--line); }
  .trust-grid article:nth-child(odd) { border-right: 1px solid var(--line); }
  .trust-grid p { margin-top: 0.7rem; color: var(--ink-soft); }
  .faq-section { background: var(--seafoam); }
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }
  .faq-intro { position: sticky; top: 2rem; }
  .faq-intro h2 { max-width: 11ch; }
  .faq-intro > p:not(.eyebrow) { margin-top: 1.2rem; color: var(--ink-soft); }
  .faq-list { border-top: 1px solid rgb(6 79 85 / 18%); }
  .faq-list details { border-bottom: 1px solid rgb(6 79 85 / 18%); }
  .faq-list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    color: var(--ink);
    cursor: pointer;
    font-size: 1.04rem;
    font-weight: 800;
    list-style: none;
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after {
    content: "+";
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: white;
    color: var(--ocean);
  }
  .faq-list details[open] summary::after { content: "−"; }
  .faq-list details p {
    max-width: 45rem;
    padding: 0 3rem 1.4rem 0;
    color: var(--ink-soft);
  }
  .owner-cta {
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: linear-gradient(120deg, #073f43, var(--ocean-deep) 58%, var(--ocean));
    color: white;
  }
  .owner-cta__inner {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
  }
  .owner-cta h2 { max-width: 12ch; }
  .owner-cta .eyebrow { color: #ffd46c; }
  .owner-cta__inner > div:first-child > p:last-child {
    max-width: 42rem;
    margin-top: 1.2rem;
    color: rgb(255 255 255 / 78%);
  }
  .cta-actions {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 15rem;
  }
  @media (max-width: 900px) {
    .owner-hero__inner,
    .process-layout,
    .model-layout,
    .trust-layout,
    .faq-layout {
      grid-template-columns: 1fr;
    }
    .owner-hero__copy { max-width: 45rem; }
    .hero-card { max-width: 32rem; }
    .benefit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .process-intro,
    .faq-intro { position: static; }
  }
  @media (max-width: 620px) {
    .owner-hero { min-height: 47rem; }
    .owner-hero__inner { align-content: end; padding-block: 3.5rem 2rem; }
    .hero-actions,
    .owner-cta__inner {
      align-items: stretch;
      flex-direction: column;
    }
    .hero-link { text-align: center; }
    .hero-card { padding: 1.2rem; }
    .hero-card li { grid-template-columns: 6rem 1fr; }
    .owner-heading { flex-direction: column; }
    .benefit-grid,
    .trust-grid { grid-template-columns: 1fr; }
    .benefit-card { min-height: auto; }
    .benefit-card h3 { margin-top: 2rem; }
    .process-list li { grid-template-columns: 2.7rem 1fr; gap: 0.9rem; }
    .trust-grid article:nth-child(odd) { border-right: 0; }
    .owner-cta__inner { align-items: stretch; }
    .cta-actions { min-width: 0; }
  }
</style>
