---
import { site } from "../config/site";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.shortName} — início`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" role="img">
          <path d="M10 28c5.2-5.7 10.3-8.5 15.4-8.5 4.9 0 9.1 2.2 12.6 6.5" />
          <path d="M11 34c4.4-3.1 8.7-4.7 12.8-4.7 4.4 0 8.8 1.6 13.2 4.7" />
          <circle cx="34.5" cy="13.5" r="3.5" />
        </svg>
      </span>
      <span class="brand-copy"><span class="brand-name">Cumbuco</span><span class="brand-detail">Aluguéis · Ceará</span></span>
    </a>

    <nav class="desktop-navigation" aria-label="Navegação principal">
      <ul class="primary-list">
        {site.primaryNavigation.map((item) => (
          <li class={"children" in item ? "has-children" : undefined}>
            <a href={item.href}>{item.label}</a>
            {"children" in item && item.children && (
              <ul class="submenu">
                {item.children.map((child) => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-cta" href="/contact-cumbuco-rentals/">Planeje sua estadia</a>

    <details class="mobile-menu">
      <summary><span class="menu-icon" aria-hidden="true"><i></i><i></i></span><span>Menu</span></summary>
      <nav aria-label="Navegação móvel">
        <ul class="mobile-list">
          {site.primaryNavigation.map((item) => (
            <li class={"children" in item ? "mobile-group" : undefined}>
              <a href={item.href}>{item.label}</a>
              {"children" in item && item.children && (
                <ul class="mobile-submenu">
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgb(255 253 247 / 92%);
    box-shadow: 0 0.45rem 1.8rem rgb(6 79 85 / 6%);
    backdrop-filter: blur(18px) saturate(145%);
  }

  .site-header::before { position: absolute; inset: 0 0 auto; height: 0.2rem; background: linear-gradient(90deg, var(--ocean-deep), var(--lagoon) 58%, var(--coral)); content: ""; }

  .header-inner {
    min-height: 4.75rem;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand-mark { display: grid; width: 2.65rem; height: 2.65rem; flex: 0 0 auto; place-items: center; border-radius: 50%; background: var(--ocean-deep); box-shadow: 0 0.5rem 1.2rem rgb(6 79 85 / 18%); }
  .brand-mark svg { width: 2rem; height: 2rem; fill: none; stroke: white; stroke-linecap: round; stroke-width: 2.3; }
  .brand-mark circle { fill: var(--sun); stroke: none; }
  .brand-copy { display: grid; gap: 0.12rem; }
  .brand-name { color: var(--ocean-deep); font-family: "Fraunces", Georgia, serif; font-size: clamp(1.55rem, 2.2vw, 1.95rem); font-weight: 700; line-height: 0.9; letter-spacing: -0.035em; }
  .brand-detail { color: var(--coral); font-size: 0.59rem; font-weight: 900; letter-spacing: 0.16em; line-height: 1; text-transform: uppercase; }

  .desktop-navigation {
    margin-left: auto;
  }

  .primary-list,
  .submenu,
  .mobile-list,
  .mobile-submenu {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-list {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 1.7vw, 1.7rem);
  }

  .primary-list > li {
    position: relative;
  }

  nav a {
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--ocean);
  }

  .has-children > a {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
  }

  .has-children > a::after {
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    content: "";
    transform: translateY(-0.12rem) rotate(45deg);
  }

  .submenu {
    position: absolute;
    top: calc(100% + 0.8rem);
    left: -1rem;
    min-width: 12.5rem;
    padding: 0.55rem;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--paper);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.4rem);
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms ease;
  }

  .submenu::before {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 0.9rem;
    content: "";
  }

  .has-children:hover .submenu,
  .has-children:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .submenu a {
    display: block;
    padding: 0.65rem 0.75rem;
    border-radius: 0.55rem;
    white-space: nowrap;
  }

  .submenu a:hover,
  .submenu a:focus-visible {
    background: var(--sand);
  }

  .header-cta {
    flex: 0 0 auto;
    padding: 0.72rem 1.08rem;
    border-radius: 999px;
    background: var(--coral);
    color: white;
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-cta:hover {
    background: var(--ocean);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 980px) {
    .header-inner {
      gap: 0.65rem;
    }

    .desktop-navigation {
      display: none;
    }

    .header-cta {
      margin-left: auto;
    }

    .mobile-menu {
      position: relative;
      display: block;
    }

    .mobile-menu summary {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      gap: 0.55rem;
      padding: 0.55rem 0.78rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--ocean);
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 800;
      list-style: none;
    }

    .menu-icon { display: grid; width: 1rem; gap: 0.25rem; }
    .menu-icon i { display: block; height: 1.5px; border-radius: 1rem; background: currentColor; transition: transform 160ms ease; }
    .mobile-menu[open] .menu-icon i:first-child { transform: translateY(0.18rem) rotate(45deg); }
    .mobile-menu[open] .menu-icon i:last-child { transform: translateY(-0.18rem) rotate(-45deg); }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu[open] summary {
      border-color: var(--ocean);
      background: var(--ocean);
      color: white;
    }

    .mobile-menu nav {
      position: absolute;
      top: calc(100% + 0.6rem);
      right: 0;
      display: block;
      width: min(18rem, calc(100vw - 2rem));
      max-height: min(34rem, calc(100vh - 7rem));
      overflow-y: auto;
      margin: 0;
      padding: 0.65rem;
      border: 1px solid var(--line);
      border-radius: 0.9rem;
      background: var(--paper);
      box-shadow: var(--shadow);
    }

    .mobile-list > li > a {
      display: block;
      padding: 0.7rem 0.8rem;
      border-radius: 0.55rem;
    }

    .mobile-list > li > a:hover,
    .mobile-list > li > a:focus-visible {
      background: var(--sand);
    }

    .mobile-group {
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--line);
      margin-bottom: 0.4rem;
    }

    .mobile-submenu {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.2rem;
      padding: 0 0.5rem 0.35rem;
    }

    .mobile-submenu a {
      display: block;
      padding: 0.48rem 0.35rem;
      color: var(--ocean);
      font-size: 0.78rem;
    }
  }

  @media (max-width: 680px) {
    .header-inner {
      min-height: 4.35rem;
    }

    .header-cta {
      display: none;
    }

    .mobile-menu {
      margin-left: auto;
    }
  }

  @media (max-width: 390px) {
    .brand { gap: 0.55rem; }
    .brand-mark { width: 2.35rem; height: 2.35rem; }
    .brand-mark svg { width: 1.75rem; height: 1.75rem; }
    .brand-name { font-size: 1.45rem; }
    .brand-detail { font-size: 0.5rem; letter-spacing: 0.12em; }
    .mobile-menu summary { padding-inline: 0.68rem; }
  }
</style>
