---
interface PropertyOption {
  title: string;
  slug: string;
  maxGuests: number | null;
}

interface Props {
  property?: string;
  slug?: string;
  maxGuests?: number | null;
  properties?: PropertyOption[];
  compact?: boolean;
}

const { property, slug, maxGuests = null, properties = [], compact = false } = Astro.props;
const fixedProperty = Boolean(property && slug);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<form class:list={["enquiry-form", { compact }]} data-enquiry-form data-property={property} data-property-slug={slug} action="/api/enquiry" method="post">
  <div class="form-heading">
    <p class="eyebrow">{fixedProperty ? `Consulte ${property}` : "Consulta de aluguel"}</p>
    <h2>Conte como será sua estadia.</h2>
    <p>Preencha as datas, o número de hóspedes e seu nome. Envie a consulta por e-mail ou abra uma mensagem pronta no WhatsApp para confirmarmos disponibilidade e valor.</p>
  </div>

  <div class="form-body">
    <div class="fields">
      {fixedProperty ? (
        <>
          <input type="hidden" name="property" value={property} />
          <input type="hidden" name="propertySlug" value={slug} />
        </>
      ) : (
        <label class="wide">
          <span>Imóvel</span>
          <select name="propertyChoice" required>
            <option value="">Escolha um imóvel</option>
            {properties.map((item) => <option value={item.slug} data-title={item.title} data-max-guests={item.maxGuests ?? ""}>{item.title}</option>)}
          </select>
        </label>
      )}
      <label>
        <span>Chegada</span>
        <input type="date" name="arrival" required />
      </label>
      <label>
        <span>Saída</span>
        <input type="date" name="departure" required />
      </label>
      <label>
        <span>Hóspedes</span>
        <input type="number" name="guests" min="1" max={maxGuests ?? 30} required />
      </label>
      <label>
        <span>Seu nome</span>
        <input type="text" name="name" autocomplete="name" minlength="2" maxlength="100" required />
      </label>
      <label class="wide">
        <span>Seu e-mail</span>
        <input type="email" name="email" autocomplete="email" maxlength="254" placeholder="Opcional" />
      </label>
      <label class="wide">
        <span>Algo que devemos saber?</span>
        <textarea name="message" rows="4" maxlength="2000" placeholder="Crianças, traslado do aeroporto, pedidos especiais…"></textarea>
      </label>
      <label class="honeypot" aria-hidden="true">
        <span>Site</span>
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <label class="consent wide">
        <input type="checkbox" name="consent" required />
        <span>Concordo que Cumbuco Aluguéis use estes dados para responder à minha consulta. Veja nossa <a href="/privacy-cookies/">política de privacidade</a>.</span>
      </label>
      {turnstileSiteKey && <div class="turnstile wide"><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-size="flexible"></div></div>}
    </div>

    <div class="form-actions">
      {turnstileSiteKey && <button class="button button--email" type="submit">Enviar por e-mail</button>}
      <button class="button button--whatsapp" type="button" data-whatsapp-submit>Enviar consulta pelo WhatsApp <span aria-hidden="true">→</span></button>
    </div>
    <p class="form-note"><strong>Sem reserva automática:</strong> você recebe a disponibilidade e o valor completo antes de decidir.</p>
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
  </div>
</form>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
    const arrival = form.elements.namedItem('arrival') as HTMLInputElement;
    const departure = form.elements.namedItem('departure') as HTMLInputElement;
    const guests = form.elements.namedItem('guests') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const propertyChoice = form.elements.namedItem('propertyChoice') as HTMLSelectElement | null;
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const whatsapp = form.querySelector<HTMLButtonElement>('[data-whatsapp-submit]');
    const localIso = (date: Date) =>
      `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    const today = localIso(new Date());
    const bookingHorizon = new Date();
    bookingHorizon.setFullYear(bookingHorizon.getFullYear() + 2);
    const latestBookingDate = localIso(bookingHorizon);
    const nextDay = (iso: string) => {
      const date = new Date(`${iso}T12:00:00`);
      date.setDate(date.getDate() + 1);
      return localIso(date);
    };
    const selectedProperty = () => {
      if (!propertyChoice) return { title: form.dataset.property || '', slug: form.dataset.propertySlug || '' };
      const option = propertyChoice.selectedOptions[0];
      return { title: option?.dataset.title || '', slug: option?.value || '' };
    };
    const showStatus = (message: string, state: 'success' | 'error' | 'neutral' = 'neutral') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };
    const validateStay = () => {
      if (!form.reportValidity()) return false;
      if (departure.value <= arrival.value) {
        showStatus('A data de saída deve ser posterior à chegada.', 'error');
        departure.focus();
        return false;
      }
      return true;
    };

    arrival.min = today;
    arrival.max = latestBookingDate;
    departure.min = today;
    departure.max = latestBookingDate;

    arrival.addEventListener('change', () => {
      departure.min = arrival.value ? nextDay(arrival.value) : today;
      if (departure.value && departure.value <= arrival.value) departure.value = '';
    });

    propertyChoice?.addEventListener('change', () => {
      const maximum = Number(propertyChoice.selectedOptions[0]?.dataset.maxGuests || 30);
      guests.max = String(maximum);
      if (Number(guests.value) > maximum) guests.value = String(maximum);
    });

    document.addEventListener('availability:dates-selected', (event) => {
      const detail = (event as CustomEvent<{ slug?: string; arrival?: string; departure?: string }>).detail;
      if (!detail || detail.slug !== form.dataset.propertySlug || !detail.arrival || !detail.departure) return;
      arrival.value = detail.arrival;
      arrival.dispatchEvent(new Event('change', { bubbles: true }));
      departure.value = detail.departure;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => guests.focus({ preventScroll: true }), 450);
    });

    whatsapp?.addEventListener('click', () => {
      email.setCustomValidity('');
      if (!validateStay()) return;
      const data = new FormData(form);
      const selected = selectedProperty();
      const lines = [
        `Olá, gostaria de consultar o imóvel ${selected.title}.`,
        '',
        `Chegada: ${data.get('arrival')}`,
        `Saída: ${data.get('departure')}`,
        `Hóspedes: ${data.get('guests')}`,
        `Nome: ${data.get('name')}`,
      ];
      const message = String(data.get('message') || '').trim();
      if (message) lines.push(`Mensagem: ${message}`);
      window.open(`https://wa.me/5585988139402?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener,noreferrer');
      showStatus('O WhatsApp foi aberto com os dados da sua consulta.', 'success');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      email.setCustomValidity(email.value.trim() ? '' : 'Informe seu e-mail para enviar esta consulta por e-mail.');
      if (!validateStay()) return;
      const selected = selectedProperty();
      const token = (form.elements.namedItem('cf-turnstile-response') as HTMLInputElement | null)?.value || '';
      if (!token) {
        showStatus('Conclua a verificação de segurança.', 'error');
        return;
      }
      const data = new FormData(form);
      submit?.setAttribute('disabled', '');
      showStatus('Enviando sua consulta…');
      try {
        const response = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            property: selected.title,
            propertySlug: selected.slug,
            arrival: data.get('arrival'),
            departure: data.get('departure'),
            guests: Number(data.get('guests')),
            name: data.get('name'),
            email: data.get('email'),
            message: data.get('message'),
            website: data.get('website'),
            consent: data.get('consent') === 'on',
            turnstileToken: token,
          }),
        });
        const result = await response.json() as { ok?: boolean; reference?: string; error?: string };
        if (!response.ok || !result.ok) throw new Error(result.error || 'Não foi possível enviar o e-mail.');
        showStatus(`Obrigado — sua consulta foi enviada. Referência: ${result.reference}. Responderemos pessoalmente.`, 'success');
        form.reset();
        arrival.min = today;
        departure.min = today;
        (window as any).turnstile?.reset(form.querySelector('.cf-turnstile'));
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'Não foi possível enviar o e-mail. Use o WhatsApp.', 'error');
        (window as any).turnstile?.reset(form.querySelector('.cf-turnstile'));
      } finally {
        submit?.removeAttribute('disabled');
      }
    });
  });
</script>

<style>
  .enquiry-form { display: grid; grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .enquiry-form.compact { grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr); }
  .form-heading h2 { max-width: 10ch; }
  .form-heading > p:not(.eyebrow) { max-width: 30rem; margin-top: 1.25rem; color: #e2efec; font-size: 1.02rem; }
  .form-body { min-width: 0; padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid rgb(255 255 255 / 55%); border-radius: 1.25rem; background: #f8fbfa; color: var(--ink); box-shadow: 0 1.2rem 3.5rem rgb(1 45 48 / 24%); }
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  label { display: grid; gap: 0.45rem; }
  label > span { color: var(--ocean-deep); font-size: 0.8rem; font-weight: 800; }
  input, textarea, select { width: 100%; border: 1px solid #b8ceca; border-radius: 0.75rem; background: white; color: var(--ink); outline: none; box-shadow: inset 0 1px 2px rgb(9 64 67 / 4%); }
  input::placeholder, textarea::placeholder { color: #526a6a; opacity: 1; }
  input, select { min-height: 3.15rem; padding: 0.65rem 0.8rem; }
  select option { color: var(--ink); background: white; }
  textarea { resize: vertical; padding: 0.8rem; }
  input:focus, textarea:focus, select:focus { border-color: var(--ocean); box-shadow: 0 0 0 3px rgb(5 124 131 / 16%); }
  input::-webkit-calendar-picker-indicator { filter: none; }
  .wide { grid-column: 1 / -1; }
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .consent { grid-template-columns: auto 1fr; align-items: start; gap: 0.7rem; }
  .consent input { width: 1.2rem; min-height: 1.2rem; margin-top: 0.1rem; accent-color: var(--ocean); }
  .consent span { color: #334f50; font-size: 0.82rem; font-weight: 500; line-height: 1.5; }
  .consent a { color: var(--ocean-deep); font-weight: 800; text-underline-offset: 0.18em; }
  .turnstile { min-height: 65px; }
  .form-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
  .button--email { border-color: var(--ocean); background: white; color: var(--ocean-deep); }
  .button--whatsapp { min-width: min(100%, 19rem); border-color: #25d366; background: #25d366; color: #073f27; box-shadow: 0 0.6rem 1.4rem rgb(37 211 102 / 20%); }
  .button--whatsapp:hover { border-color: #45e17e; background: #45e17e; }
  .button--whatsapp span { margin-left: 0.4rem; font-size: 1.1rem; }
  .button:disabled { cursor: not-allowed; opacity: 0.55; transform: none; }
  .form-note { margin-top: 1rem; color: #496668; font-size: 0.78rem; }
  .form-status { min-height: 1.5em; margin-top: 0.65rem; color: var(--ink-soft); font-weight: 700; }
  .form-status:empty { display: none; }
  .form-status[data-state="success"] { color: #087b45; }
  .form-status[data-state="error"] { color: #a93625; }
  @media (max-width: 780px) { .enquiry-form, .enquiry-form.compact { grid-template-columns: 1fr; } .form-heading h2 { max-width: none; } }
  @media (max-width: 520px) { .fields { grid-template-columns: 1fr; } .wide { grid-column: 1; } .form-actions { align-items: stretch; flex-direction: column; } }
</style>
