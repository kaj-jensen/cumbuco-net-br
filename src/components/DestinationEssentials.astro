---
interface Props { locale?: "pt" | "en"; }
const { locale = "pt" } = Astro.props;
const pt = locale === "pt";
const months = pt
  ? ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"]
  : ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const wind = [28, 30, 34, 42, 50, 68, 88, 100, 98, 91, 75, 48];
---

<section class="section essentials" aria-labelledby="essentials-title">
  <div class="shell essentials-heading">
    <div>
      <p class="eyebrow">{pt ? "Cumbuco de forma visual" : "Cumbuco at a glance"}</p>
      <h2 id="essentials-title">{pt ? "Praia, vento e tudo por perto." : "Beach, wind, and everything close by."}</h2>
    </div>
    <p>{pt
      ? "Um resumo rápido para ajudar você a escolher a época, entender a localização e planejar os dias antes de chegar."
      : "A quick visual guide to help you choose the season, understand the location, and plan your days before you arrive."}</p>
  </div>

  <div class="shell visual-grid">
    <article class="map-card">
      <header><span>03° 37′ S</span><h3>{pt ? "Onde fica Cumbuco" : "Where Cumbuco is"}</h3></header>
      <div class="map" role="img" aria-label={pt ? "Mapa ilustrado entre Fortaleza, Cumbuco, dunas e lagoas" : "Illustrated map between Fortaleza, Cumbuco, dunes, and lagoons"}>
        <svg viewBox="0 0 720 380" aria-hidden="true">
          <defs>
            <linearGradient id="sea" x1="0" x2="1"><stop stop-color="#bcebec"/><stop offset="1" stop-color="#78d3d9"/></linearGradient>
            <pattern id="waves" width="42" height="20" patternUnits="userSpaceOnUse"><path d="M0 11c7-7 14-7 21 0s14 7 21 0" fill="none" stroke="#fff" stroke-opacity=".48" stroke-width="2"/></pattern>
          </defs>
          <path d="M0 0h720v380H0z" fill="url(#sea)"/>
          <path d="M0 0h438c-16 68-4 111 28 151 27 34 25 72-7 114-25 33-28 71-12 115H0z" fill="#fff5dc"/>
          <path d="M447 0c-16 68-4 111 28 151 27 34 25 72-7 114-25 33-28 71-12 115" fill="none" stroke="#fff" stroke-width="10"/>
          <path d="M0 0h720v380H0z" fill="url(#waves)"/>
          <path d="M118 298C212 276 253 208 327 161s99-72 129-99" fill="none" stroke="#bd735b" stroke-dasharray="7 9" stroke-width="4"/>
          <circle cx="118" cy="298" r="10" fill="#b9472f"/><circle cx="327" cy="161" r="13" fill="#064f55"/><circle cx="456" cy="62" r="8" fill="#f4bf3a"/>
          <path d="M299 161a28 28 0 1 1 56 0c0 22-28 52-28 52s-28-30-28-52Z" fill="#064f55"/><circle cx="327" cy="160" r="9" fill="#f4bf3a"/>
          <g fill="#b88d53"><path d="m195 80 34-28 33 28Z"/><path d="m229 80 38-34 39 34Z"/></g>
          <ellipse cx="232" cy="111" rx="48" ry="21" fill="#53c5bd"/>
        </svg>
        <span class="label label--fortaleza">Fortaleza<small>{pt ? "Aeroporto" : "Airport"}</small></span>
        <span class="label label--cumbuco">Cumbuco<small>{pt ? "Vila e praia" : "Village & beach"}</small></span>
        <span class="label label--north">{pt ? "Costa oeste" : "West coast"}<small>{pt ? "Praias e lagoas" : "Beaches & lagoons"}</small></span>
        <span class="label label--dunes">{pt ? "Dunas" : "Dunes"}</span>
      </div>
      <footer><strong>30 km</strong><span>{pt ? "de Fortaleza · acesso fácil pelo aeroporto" : "from Fortaleza · an easy airport transfer"}</span></footer>
    </article>

    <article class="season-card">
      <header><span>{pt ? "Planeje pela estação" : "Plan by season"}</span><h3>{pt ? "Temporada de vento" : "Wind season"}</h3></header>
      <p>{pt ? "O vento costuma ganhar força a partir de julho, com dias quentes e água agradável durante todo o ano." : "The trade wind usually strengthens from July, while warm days and comfortable water continue throughout the year."}</p>
      <div class="wind-chart" aria-label={pt ? "Intensidade relativa do vento por mês" : "Relative wind strength by month"}>
        {months.map((month, index) => <div class:list={["wind-month", { peak: index >= 6 && index <= 10 }]}><i style={`--wind:${wind[index]}%`}></i><span>{month}</span></div>)}
      </div>
      <div class="season-key"><span><i></i>{pt ? "Vento mais leve" : "Lighter wind"}</span><span><i></i>{pt ? "Melhor período para kite" : "Prime kite season"}</span></div>
    </article>
  </div>

  <div class="shell confidence-grid">
    <article><span aria-hidden="true">⌁</span><div><h3>{pt ? "Conhecimento local" : "Local knowledge"}</h3><p>{pt ? "Orientação pessoal para escolher a casa e a região certas." : "Personal guidance to choose the right home and area."}</p></div></article>
    <article><span aria-hidden="true">✓</span><div><h3>{pt ? "Disponibilidade verificada" : "Checked availability"}</h3><p>{pt ? "Datas e custo total confirmados antes de qualquer decisão." : "Dates and complete costs confirmed before any decision."}</p></div></article>
    <article><span aria-hidden="true">↗</span><div><h3>{pt ? "Contato direto" : "Direct contact"}</h3><p>{pt ? "Converse conosco por WhatsApp, sem reserva automática." : "Talk to us on WhatsApp, with no automatic booking."}</p></div></article>
  </div>
</section>

<style>
  .essentials { overflow: hidden; background: var(--paper); }
  .essentials-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, .72fr); gap: 2rem 5rem; align-items: end; }
  .essentials-heading h2 { max-width: 13ch; }
  .essentials-heading > p { max-width: 38rem; color: var(--ink-soft); font-size: 1.02rem; }
  .visual-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 1.25rem; margin-top: 2.5rem; }
  .map-card, .season-card { overflow: hidden; border: 1px solid var(--line); border-radius: calc(var(--radius) + .25rem); background: white; box-shadow: 0 1rem 3rem rgb(6 79 85 / 8%); }
  article > header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1.35rem 1.5rem; }
  article > header > span { color: var(--coral); font-size: .7rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  article > header h3 { font-size: 1.45rem; }
  .map { position: relative; min-height: 21rem; overflow: hidden; background: var(--sky); }
  .map svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .label { position: absolute; display: grid; padding: .45rem .65rem; border-radius: .65rem; background: rgb(255 253 247 / 92%); color: var(--ocean-deep); font-size: .76rem; font-weight: 900; line-height: 1.15; box-shadow: 0 .35rem 1rem rgb(6 79 85 / 15%); }
  .label small { margin-top: .15rem; color: var(--ink-soft); font-size: .59rem; font-weight: 700; }
  .label--fortaleza { left: 8%; bottom: 9%; }.label--cumbuco { left: 42%; top: 38%; }.label--north { right: 7%; top: 12%; }.label--dunes { left: 28%; top: 15%; background: #fff0ca; }
  .map-card footer { display: flex; align-items: baseline; gap: .65rem; padding: 1rem 1.5rem; background: var(--ocean-deep); color: white; }
  .map-card footer strong { font-family: "Fraunces", Georgia, serif; font-size: 1.8rem; }.map-card footer span { color: #cde7e5; font-size: .82rem; }
  .season-card { padding-bottom: 1.25rem; background: linear-gradient(160deg, #fffdf7, #effbf7); }
  .season-card > p { max-width: 32rem; padding: 0 1.5rem; color: var(--ink-soft); font-size: .93rem; }
  .wind-chart { height: 14rem; display: grid; grid-template-columns: repeat(12, 1fr); gap: .35rem; align-items: end; margin: 2rem 1.5rem 0; padding-top: 1rem; border-bottom: 1px solid var(--line); background: repeating-linear-gradient(to bottom, transparent 0 24%, rgb(6 79 85 / 7%) 25%); }
  .wind-month { height: 100%; display: grid; grid-template-rows: 1fr auto; align-items: end; gap: .5rem; }
  .wind-month i { width: 100%; height: var(--wind); min-height: .5rem; border-radius: .4rem .4rem 0 0; background: #b9deda; }
  .wind-month.peak i { background: linear-gradient(#11aab0, #057c83); }
  .wind-month span { color: var(--ink-soft); font-size: .58rem; font-weight: 800; text-align: center; }
  .season-key { display: flex; flex-wrap: wrap; gap: .75rem 1.2rem; padding: 1rem 1.5rem 0; color: var(--ink-soft); font-size: .72rem; }
  .season-key span { display: flex; align-items: center; gap: .4rem; }.season-key i { width: .65rem; height: .65rem; border-radius: .2rem; background: #b9deda; }.season-key span:last-child i { background: var(--ocean); }
  .confidence-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.25rem; }
  .confidence-grid article { display: grid; grid-template-columns: auto 1fr; gap: .9rem; padding: 1.2rem; border: 1px solid var(--line); border-radius: 1rem; background: var(--sand); }
  .confidence-grid article > span { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border-radius: 50%; background: var(--ocean-deep); color: white; font-size: 1.15rem; font-weight: 900; }
  .confidence-grid h3 { font-family: "DM Sans", sans-serif; font-size: .94rem; letter-spacing: 0; }.confidence-grid p { margin-top: .25rem; color: var(--ink-soft); font-size: .78rem; }
  @media (max-width: 850px) { .essentials-heading, .visual-grid { grid-template-columns: 1fr; }.confidence-grid { grid-template-columns: 1fr; }.map { min-height: 18rem; } }
  @media (max-width: 520px) { article > header { align-items: flex-start; flex-direction: column; }.map { min-height: 16rem; }.label--north { right: 3%; }.wind-chart { gap: .2rem; margin-inline: .8rem; }.wind-month span { font-size: .5rem; }.map-card footer { align-items: flex-start; flex-direction: column; } }
</style>
