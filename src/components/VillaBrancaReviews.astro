---
const googleReviewsUrl = "https://share.google/EpocNw26PXZCqq8yJ";

const reviews = [
  {
    quote: "Bom para passar o tempo com a família — e com bom custo-benefício.",
    author: "Wellington",
    date: "março de 2024",
  },
  {
    quote: "Foi magnífico.",
    author: "Francisco Warner",
    date: "novembro de 2023",
  },
  {
    quote: "Um lugar tranquilo. Fomos muito bem atendidos.",
    author: "Mary Jane",
    date: "julho de 2023",
  },
];
---

<section class="villa-reviews" aria-labelledby="villa-reviews-title">
  <div class="reviews-intro">
    <div>
      <p class="eyebrow">Avaliações no Google</p>
      <h2 id="villa-reviews-title">O que os visitantes dizem sobre a Villa Branca.</h2>
      <p class="reviews-note">A Villa Branca é uma das casas à beira-mar apresentadas pelo Cumbuco Aluguéis. Estas avaliações referem-se especificamente à Villa Branca.</p>
    </div>
    <a class="rating" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">
      <span class="rating-score">4.6</span>
      <span class="stars">★★★★★</span>
      <span>175 avaliações no Google</span>
    </a>
  </div>

  <div class="review-grid">
    {reviews.map((review) => (
      <figure class="review-card">
        <div class="review-stars" aria-label="5 de 5 estrelas">★★★★★</div>
        <blockquote>“{review.quote}”</blockquote>
        <figcaption>{review.author} <span>· avaliação no Google · {review.date}</span></figcaption>
      </figure>
    ))}
  </div>

  <a class="review-link" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">Ler todas as avaliações da Villa Branca no Google <span aria-hidden="true">↗</span></a>
</section>

<style>
  .villa-reviews { display: grid; gap: 1.5rem; }
  .reviews-intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(2rem, 7vw, 6rem); align-items: end; }
  .reviews-intro h2 { max-width: 14ch; }
  .reviews-note { max-width: 42rem; margin-top: 1rem; color: var(--ink-soft); }
  .rating { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 0.75rem; min-width: 13rem; padding: 1.25rem 1.4rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); text-decoration: none; box-shadow: 0 0.8rem 2.5rem rgb(20 51 48 / 8%); }
  .rating-score { grid-row: 1 / 3; font-family: "Fraunces", Georgia, serif; font-size: 3rem; font-weight: 600; line-height: 1; }
  .rating span:last-child { color: var(--ink-soft); font-size: 0.82rem; }
  .stars, .review-stars { color: #e6a400; letter-spacing: 0.08em; }
  .review-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .review-card { display: grid; grid-template-rows: auto 1fr auto; min-height: 12rem; margin: 0; padding: clamp(1.25rem, 2vw, 1.65rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }
  .review-card blockquote { display: flex; align-items: center; margin: 1rem 0; font-family: "Fraunces", Georgia, serif; font-size: clamp(1.35rem, 2.3vw, 1.8rem); line-height: 1.25; letter-spacing: -0.025em; }
  .review-card figcaption { font-weight: 700; }
  .review-card figcaption span { color: var(--ink-soft); font-size: 0.8rem; font-weight: 400; }
  .review-link { width: fit-content; color: var(--ocean); font-weight: 700; text-underline-offset: 0.25rem; }
  @media (max-width: 800px) {
    .reviews-intro { grid-template-columns: 1fr; align-items: start; }
    .rating { width: fit-content; }
    .review-grid { grid-template-columns: 1fr; }
    .review-card { min-height: 0; }
  }
  @media (max-width: 440px) {
    .rating { width: 100%; }
    .review-card figcaption span { display: block; margin-top: 0.2rem; }
  }
</style>
